---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Pixel Jones — Creative Developer & Designer',
  description = 'Ryan "Tek" Jones. Full stack developer and designer based in Seattle, WA.',
  image = '/og-image.jpg',
} = Astro.props;

// Astro.site comes from `site:` in astro.config.mjs (https://www.pixeljones.com). Building
// share URLs off it (not a hardcoded string) is what fixes the actual bug here: og:url and
// og:image previously pointed at the old pre-custom-domain Vercel URL
// (pixel-jones-portfolio-astro.vercel.app), which is an orphaned project -- noted elsewhere
// as "worth deleting eventually." Any link share (iMessage, Slack, Twitter/X, etc.) before
// this fix would have pulled its preview from that stale project, not the real site.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#0c042c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Pixel Jones" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <!-- Splide carousel -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide-core.min.css" />
    <script is:inline src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>
    <!-- GSAP + ScrollTrigger -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
    <!-- Lenis smooth scroll — site-wide, matches the original Lumos/Webflow source's own
         convention (data-lenis-prevent attrs + lenis.start()/stop() calls already present
         in the reference component library). Synced to GSAP's ticker rather than Lenis's
         own autoRaf so ScrollTrigger scrub effects (marquee) read the smoothed position
         instead of raw scroll deltas. lerp 0.05 is Tek's approved "smoother" value from
         other builds. -->
    <script is:inline src="https://unpkg.com/lenis@1.1.14/dist/lenis.min.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        if (typeof Lenis === 'undefined' || typeof gsap === 'undefined') return;
        const lenis = new Lenis({ lerp: 0.05, smoothWheel: true, touchMultiplier: 1.5 });
        window.lenis = lenis;
        if (typeof ScrollTrigger !== 'undefined') {
          lenis.on('scroll', ScrollTrigger.update);
        }
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);
      });
    </script>
  </head>
  <body class="u-theme-dark">
    <slot />
  </body>
</html>
