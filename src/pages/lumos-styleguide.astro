                <div id="zindex-utilities" class="styleguide_group">
                  <h3 class="styleguide_subheading u-text-style-h6">Z-Index Utilities</h3>
                  <div class="styleguide_scroll">
                    {zindexes.map((cls) => (
                      <div class="styleguide_card_wrap">
                        <div class="tag_wrap">{cls}</div>
                        <div class:list={['styleguide_swatch', cls]}></div>
                      </div>
                    ))}
                  </div>
                </div>

                <div id="position-utilities" class="styleguide_group">
                  <h3 class="styleguide_subheading u-text-style-h6">Position Utilities</h3>
                  <div class="styleguide_scroll">
                    {positions.map((item) => (
                      <div class="styleguide_card_wrap">
                        <div class="tag_wrap">{item.cls}</div>
                        {item.wrapped ? (
                          <div class="u-display-none">
                            <div class:list={['styleguide_swatch', item.cls]}></div>
                          </div>
                        ) : (
                          <div class:list={['styleguide_swatch', item.cls]}></div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>

                <div id="other-utilities" class="styleguide_group">
                  <h3 class="styleguide_subheading u-text-style-h6">Element Utilities</h3>
                  <div class="styleguide_scroll">
                    {elementUtilities.map((cls) => (
                      <div class="styleguide_card_wrap">
                        <div class="tag_wrap">{cls}</div>
                        {isExcluded(cls) ? (
                          <p class="u-text-style-small">{PLACEHOLDER_NOTE}</p>
                        ) : (
                          <div class="styleguide_visual">
                            <div class={cls}></div>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>

                <div id="other-utilities-2" class="styleguide_group">
                  <h3 class="styleguide_subheading u-text-style-h6">Other Utilities</h3>
                  <div class="styleguide_scroll">
                    {otherUtilities.map((cls) => (
                      <div class="styleguide_card_wrap">
                        <div class="tag_wrap">{cls}</div>
                        {isExcluded(cls) ? (
                          <p class="u-text-style-small">{PLACEHOLDER_NOTE}</p>
                        ) : (
                          <div class="styleguide_visual">
                            <div class={cls}></div>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </section>

            <!-- ===================== Components ===================== -->
            <section id="components">
              <div class="styleguide_section">
                <h2 class="styleguide_title u-text-style-h2">Components</h2>

                <div id="buttons" class="styleguide_group">
                  <h3 class="styleguide_subheading u-text-style-h6">Buttons</h3>
                  <div class="styleguide_card_wrap">
                    <div class="tag_wrap">button_main / button_toggle / button_arrow / button_close</div>
                    <p class="u-text-style-small">{PLACEHOLDER_NOTE}</p>
                  </div>
                </div>
              </div>
            </section>

          </div>
        </div>
      </div>
    </section>

    <footer class="styleguide_footer u-section u-theme-dark">
      <div class="styleguide_contain u-container">
        <div>Lumos Framework</div>
      </div>
    </footer>
  </main>
</BaseLayout>
