---
// src/pages/lumos-styleguide.astro
// Faithful reproduction of Ryan's Spectacular Site's "Styleguide" page
// (Webflow page 6a38d135808fe206de41ae60), from its live published
// HTML/CSS. Not linked from site nav — this is a verification page
// proving the Lumos foundation layer (src/styles/lumos.css) is bug-free
// before it's used anywhere real. The ~40 mode-based utility classes
// (u-grid/u-overlay/u-video/u-image family, Button component) are
// intentionally not built — see Task 5b — and are marked as such below
// rather than omitted.
import BaseLayout from '../layouts/BaseLayout.astro';

// Classes deliberately excluded from src/styles/lumos.css (Task 5b),
// because they depend on Webflow's mode-based variant system. Verified
// against the file directly — see task-6-report.md for the grep pass.
const EXCLUDED = new Set([
  'u-heading-accent', 'u-theme-inherit', 'u-color-inherit', 'u-color-faded',
  'u-hide-if-empty-cms', 'u-grid-wrapper', 'u-grid', 'u-content-wrapper',
  'u-image-wrapper', 'u-image', 'u-height-full', 'u-iframe-wrapper', 'u-iframe',
  'u-overlay', 'u-video', 'u-svg', 'u-path', 'u-container-small', 'u-container-full',
  'u-embed-js', 'u-embed-css', 'u-width-auto', 'u-min-width-auto', 'u-max-width-none',
  'u-max-width-full', 'u-width-full', 'u-height-auto', 'u-text-trim-off',
  'u-margin-inline-auto', 'u-ignore-trim', 'u-pointer-on', 'u-pointer-off',
  'u-object-fit-cover', 'u-object-fit-contain', 'u-min-height-screen', 'u-cover',
  'u-cover-absolute',
]);
const isExcluded = (cls: string) => EXCLUDED.has(cls) || cls.startsWith('u-eyebrow');

const PLACEHOLDER_NOTE =
  'Not yet built in this port — depends on the mode-based variant system, deferred per 2026-07-07 decision.';

const LOREM_SHORT =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare';
const LOREM_MED = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.';
const LOREM_ALIGN =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique.';
const LOREM_LONG =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla, ut commodo diam libero vitae erat. Aenean faucibus nibh et justo cursus id rutrum lorem imperdiet. Nunc ut sem vitae risus tristique posuere.';

// ---- Table of contents (2-level) ----
const NAV = [
  { href: '#typography', label: 'Typography', subs: [
    { href: '#text-styles', label: 'Text Styles' },
    { href: '#weights', label: 'Weights' },
    { href: '#line-height', label: 'Line Height' },
    { href: '#letter-spacing', label: 'Letter Spacing' },
    { href: '#line-clamp', label: 'Line Clamp' },
    { href: '#text-align', label: 'Text Align' },
    { href: '#text-transform', label: 'Text Transform' },
    { href: '#text-wrap', label: 'Text Wrap' },
    { href: '#typography-elements', label: 'Elements' },
  ]},
  { href: '#color', label: 'Color', subs: [
    { href: '#themes', label: 'Themes' },
    { href: '#text-color', label: 'Text Color' },
    { href: '#background-color', label: 'Background Color' },
  ]},
  { href: '#flexbox', label: 'Flexbox', subs: [
    { href: '#flex-direction-utilities', label: 'Flex Direction' },
    { href: '#align-self-utilities', label: 'Align Self' },
    { href: '#align-items-utilities', label: 'Align Items' },
    { href: '#justify-content-utilities', label: 'Justify Content' },
    { href: '#flex-basis-utilities', label: 'Flex Basis' },
  ]},
  { href: '#grid', label: 'Grid', subs: [
    { href: '#grid-utilities', label: 'Grid Utilities' },
    { href: '#column-start-utilities', label: 'Column Start Utilities' },
    { href: '#column-utilities', label: 'Column Utilities' },
    { href: '#row-start-utilities', label: 'Row Start Utilities' },
    { href: '#row-span-utilities', label: 'Row Span Utilities' },
    { href: '#order-utilities', label: 'Order Utilities' },
  ]},
  { href: '#sizes', label: 'Sizes', subs: [
    { href: '#gap-utilities', label: 'Gap Utilities' },
    { href: '#row-gap-utilities', label: 'Row Gap Utilities' },
    { href: '#margin-top-utilities', label: 'Margin Top Utilities' },
    { href: '#margin-bottom-utilities', label: 'Margin Bottom Utilities' },
    { href: '#padding-utilities', label: 'Padding Utilities' },
    { href: '#padding-block-utilities', label: 'Padding Block Utilities' },
    { href: '#padding-inline-utilities', label: 'Padding Inline Utilities' },
    { href: '#padding-top-utilities', label: 'Padding Top Utilities' },
    { href: '#padding-bottom-utilities', label: 'Padding Bottom Utilities' },
    { href: '#padding-left-utilities', label: 'Padding Left Utilities' },
    { href: '#padding-right-utilities', label: 'Padding Right Utilities' },
    { href: '#radius-utilities', label: 'Border Radius Utilities' },
    { href: '#aspect-ratio-utilities', label: 'Aspect Ratio Utilities' },
  ]},
  { href: '#miscellaneous', label: 'Miscellaneous', subs: [
    { href: '#display-utilities', label: 'Display Utilities' },
    { href: '#overflow-utilities', label: 'Overflow Utilities' },
    { href: '#zindex-utilities', label: 'Z-Index Utilities' },
    { href: '#position-utilities', label: 'Position Utilities' },
    { href: '#other-utilities', label: 'Other Utilities' },
  ]},
  { href: '#components', label: 'Components', subs: [
    { href: '#buttons', label: 'Buttons' },
  ]},
];

// ---- Typography ----
const textStyles = [
  { cls: 'u-text-style-display', tag: 'h1', text: 'Heading' },
  { cls: 'u-text-style-h1', tag: 'h1', text: 'Heading' },
  { cls: 'u-text-style-h2', tag: 'h2', text: 'Heading' },
  { cls: 'u-text-style-h3', tag: 'h3', text: 'Heading' },
  { cls: 'u-text-style-h4', tag: 'h4', text: 'Heading' },
  { cls: 'u-text-style-h5', tag: 'h5', text: 'Heading' },
  { cls: 'u-text-style-h6', tag: 'h6', text: 'Heading' },
  { cls: 'u-text-style-large', tag: 'p', text: LOREM_SHORT },
  { cls: 'u-text-style-main', tag: 'p', text: LOREM_SHORT },
  { cls: 'u-text-style-small', tag: 'p', text: LOREM_SHORT },
];
const weights = ['u-weight-regular', 'u-weight-medium', 'u-weight-bold'];
const lineHeights = ['u-line-height-small', 'u-line-height-medium', 'u-line-height-large', 'u-line-height-huge'];
const letterSpacings = ['u-letter-spacing-tight', 'u-letter-spacing-normal'];
const lineClamps = ['u-line-clamp-1', 'u-line-clamp-2', 'u-line-clamp-3', 'u-line-clamp-4'];
const textAligns = ['u-alignment-start', 'u-alignment-center', 'u-alignment-end'];
const textTransforms = ['u-text-transform-none', 'u-text-transform-uppercase', 'u-text-transform-capitalize', 'u-text-transform-lowercase'];
const textWraps = [
  { cls: 'u-text-wrap-default', text: 'Normal text wrapping. Useful for resetting text wrapping on a child if the parent has balance or pretty.' },
  { cls: 'u-text-wrap-balance', text: 'Keeps the line width even and consistent for up to six lines of text. Ideal for short form content.' },
  { cls: 'u-text-wrap-pretty', text: "Ensures there's more than one word on the last line of text. Ideal for long form content." },
];

// ---- Color ----
const themes = ['u-theme-inherit', 'u-theme-light', 'u-theme-dark', 'u-theme-brand'];
const textColors = ['u-color-inherit', 'u-color-faded'];
const backgroundColors = ['u-background-transparent', 'u-background-1', 'u-background-2', 'u-background-skeleton'];

// ---- Flexbox ----
const flexDirections = ['u-flex-horizontal-wrap', 'u-flex-vertical-nowrap', 'u-flex-horizontal-nowrap', 'u-flex-vertical-wrap'];
const alignSelfs = ['u-align-self-inherit', 'u-align-self-start', 'u-align-self-center', 'u-align-self-end', 'u-align-self-stretch'];
const alignItemsList = ['u-align-items-inherit', 'u-align-items-start', 'u-align-items-center', 'u-align-items-end', 'u-align-items-stretch'];
const justifyContents = [
  { cls: 'u-justify-content-inherit', dots: 2 },
  { cls: 'u-justify-content-start', dots: 2 },
  { cls: 'u-justify-content-center', dots: 1 },
  { cls: 'u-justify-content-end', dots: 2 },
  { cls: 'u-justify-content-between', dots: 2 },
  { cls: 'u-justify-content-around', dots: 2 },
];
const flexBasisList = ['u-flex-shrink', 'u-flex-grow', 'u-flex-noshrink'];

// ---- Grid ----
const gridUtilities = [
  { cls: 'u-grid-autofit', boxes: 5 },
  { cls: 'u-grid-autofill', boxes: 2 },
  { cls: 'u-grid-custom', boxes: 1 },
  { cls: 'u-grid-breakout', boxes: 1 },
  { cls: 'u-grid-subgrid', boxes: 1 },
];
const columnStarts = ['u-column-start-auto', ...Array.from({ length: 12 }, (_, i) => `u-column-start-${i + 1}`)];
const columnSpans = ['u-column-span-full', 'u-column-span-indent', ...Array.from({ length: 12 }, (_, i) => `u-column-span-${i + 1}`)];
const rowStarts = ['u-row-start-auto', ...Array.from({ length: 6 }, (_, i) => `u-row-start-${i + 1}`)];
const rowSpans = Array.from({ length: 6 }, (_, i) => `u-row-span-${i + 1}`);
const orders = ['u-order-first', 'u-order-last'];

// ---- Sizes ----
const gaps = ['u-gap-inherit', 'u-gap-gutter', ...Array.from({ length: 9 }, (_, i) => `u-gap-${i}`)];
const rowGaps = ['u-gap-row-inherit', 'u-gap-row-gutter', ...Array.from({ length: 9 }, (_, i) => `u-gap-row-${i}`)];
const marginTops = ['u-margin-top-auto', 'u-margin-top-gutter', 'u-margin-top-text', ...Array.from({ length: 9 }, (_, i) => `u-margin-top-${i}`)];
const marginBottoms = ['u-margin-bottom-auto', 'u-margin-bottom-gutter', 'u-margin-bottom-text', ...Array.from({ length: 9 }, (_, i) => `u-margin-bottom-${i}`)];
const paddingSizes = ['sitemargin', 'gutter', ...Array.from({ length: 9 }, (_, i) => `${i}`), 'small', 'main', 'large'];
const paddingInlineSizes = ['sitemargin', 'gutter', ...Array.from({ length: 9 }, (_, i) => `${i}`)];
const paddingTopBottomSizes = [...paddingSizes, 'pagetop'];
const paddings = paddingSizes.map((s) => `u-padding-${s}`);
const paddingBlocks = paddingSizes.map((s) => `u-padding-block-${s}`);
const paddingInlines = paddingInlineSizes.map((s) => `u-padding-inline-${s}`);
const paddingTops = paddingTopBottomSizes.map((s) => `u-padding-top-${s}`);
const paddingBottoms = paddingTopBottomSizes.map((s) => `u-padding-bottom-${s}`);
const paddingLefts = paddingInlineSizes.map((s) => `u-padding-left-${s}`);
const paddingRights = paddingInlineSizes.map((s) => `u-padding-right-${s}`);
const radii = ['u-radius-none', 'u-radius-inherit', 'u-radius-small', 'u-radius-main', 'u-radius-round'];
const ratios = ['u-ratio-auto', 'u-ratio-2-1', 'u-ratio-16-9', 'u-ratio-3-2', 'u-ratio-5-4', 'u-ratio-1-1', 'u-ratio-4-5', 'u-ratio-2-3'];

// ---- Miscellaneous ----
const displays = ['u-display-block', 'u-display-inline-block', 'u-display-inline-flex', 'u-display-inline-grid', 'u-display-inline', 'u-display-contents', 'u-display-none', 'u-hide-if-empty-cms'];
const overflows = ['u-overflow-visible', 'u-overflow-hidden', 'u-overflow-clip', 'u-overflow-x-auto', 'u-overflow-y-auto', 'u-overflow-hidden-left'];
const zindexes = ['u-zindex-negative', 'u-zindex-0', 'u-zindex-unset', 'u-zindex-1', 'u-zindex-2', 'u-zindex-3'];
const positions = [
  { cls: 'u-position-static', wrapped: false },
  { cls: 'u-position-relative', wrapped: false },
  { cls: 'u-position-absolute', wrapped: true },
  { cls: 'u-position-fixed', wrapped: true },
  { cls: 'u-position-sticky', wrapped: false },
];
const elementUtilities = [
  'u-grid-wrapper', 'u-grid', 'u-content-wrapper', 'u-image-wrapper', 'u-image', 'u-height-full',
  'u-iframe-wrapper', 'u-iframe', 'u-overlay', 'u-eyebrow-{wrapper-layout-marker-text}', 'u-text',
  'u-button-wrapper', 'u-video', 'u-svg', 'u-path', 'u-section', 'u-container', 'u-container-small',
  'u-container-full', 'u-embed-js', 'u-embed-css',
];
const otherUtilities = [
  'u-width-auto', 'u-min-width-auto', 'u-max-width-none', 'u-max-width-full', 'u-width-full',
  'u-height-full', 'u-height-auto', 'u-text-trim-off', 'u-button-wrapper', 'u-margin-inline-auto',
  'u-margin-trim', 'u-ignore-trim', 'u-pointer-on', 'u-pointer-off', 'u-object-fit-cover',
  'u-object-fit-contain', 'u-min-height-screen', 'u-cover', 'u-cover-absolute', 'u-sr-only',
];
---
<BaseLayout title="Lumos Styleguide (Reference)">
  <main id="main">
    <section class="styleguide_wrap u-section u-theme-dark">
      <style>
        .styleguide_contain {
          display: flex;
          flex-flow: column;
        }
        .styleguide_layout {
          display: var(--flex-medium, grid);
          flex-direction: column;
          grid-template-columns: repeat(12, minmax(0, 1fr));
          gap: var(--site--gutter);
          align-items: start;
        }
        .styleguide_nav_wrap {
          grid-column: 9 / span 4;
          width: 100%;
          order: 1;
          position: var(--relative-medium, sticky);
          top: var(--site--margin);
          max-height: calc(100svh - var(--site--margin) * 2);
        }
        .styleguide_nav_card {
          width: 100%;
          padding: var(--_spacing---space--4);
          border-radius: var(--radius--small);
          overflow: clip auto;
          max-height: inherit;
        }
        .styleguide_nav_list,
        .styleguide_nav_sub_list {
          list-style: none;
          margin: 0;
          padding: 0;
        }
        .styleguide_nav_list {
          border-left: var(--border-width--main) solid var(--_theme---border);
        }
        .styleguide_nav_item {
          margin-left: calc(var(--border-width--main) * -0.5);
        }
        .styleguide_nav_link {
          display: block;
          padding: 0.125rem 0 0.125rem 0.75rem;
          font-weight: var(--_typography---font--primary-medium);
        }
        .styleguide_nav_sub_link {
          display: block;
          padding: 0.125rem 1.1rem;
          line-height: var(--_typography---line-height--large);
          color: color-mix(in hsl, currentColor 60%, transparent);
        }
        .styleguide_content {
          grid-column: 1 / span 8;
          width: 100%;
          display: flex;
          flex-direction: column;
        }
        .styleguide_section {
          display: flex;
          flex-direction: column;
          gap: var(--_spacing---space--5);
          padding-top: var(--_spacing---section-space--small);
        }
        .styleguide_title {
          margin-bottom: var(--_spacing---space--5);
        }
        .styleguide_group {
          display: flex;
          flex-direction: column;
          gap: var(--_spacing---space--5);
          padding-top: var(--_spacing---space--7);
        }
        .styleguide_subheading {
          margin-bottom: 0;
        }
        .tag_wrap {
          display: inline-block;
          min-width: 4rem;
          padding: 0.5rem 0.75rem;
          border-radius: var(--radius--small);
          background-color: var(--_theme---text);
          color: var(--_theme---background);
          line-height: var(--_typography---line-height--small);
          text-align: center;
        }
        .styleguide_scroll {
          display: flex;
          gap: var(--site--gutter);
          padding-left: var(--site--margin);
          padding-right: var(--site--margin);
          margin-left: calc(var(--site--margin) * -1);
          margin-right: calc(var(--site--margin) * -1);
          overflow-x: auto;
          -webkit-mask-image: linear-gradient(to right, transparent, black 3% 97%, transparent);
          mask-image: linear-gradient(to right, transparent, black 3% 97%, transparent);
        }
        .styleguide_list {
          display: flex;
          flex-direction: column;
          gap: var(--site--gutter);
        }
        .styleguide_font_item {
          display: flex;
          flex-direction: column;
          gap: var(--_spacing---space--4);
          padding-top: var(--_spacing---space--5);
          padding-bottom: var(--_spacing---space--5);
          border-bottom: var(--border-width--main) solid var(--_theme---border);
        }
        .styleguide_card_wrap {
          display: flex;
          flex-direction: column;
          flex-shrink: 0;
          justify-content: space-between;
          align-items: flex-start;
          gap: var(--_spacing---space--6);
          min-width: min(20rem, 100%);
          padding: var(--_spacing---space--5);
          border-radius: var(--radius--main);
          background-color: var(--_theme---background-2);
          position: relative;
          overflow: hidden;
        }
        .styleguide_visual {
          width: 100%;
          max-height: 7rem;
          aspect-ratio: 3 / 1.5;
          padding: var(--_spacing---space--1);
          border: var(--border-width--main) solid var(--_theme---border);
          border-radius: var(--radius--small);
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          position: relative;
          overflow: hidden;
        }
        .styleguide_visual_fill {
          position: absolute;
          inset: 0;
          border-radius: inherit;
        }
        .styleguide_card_visual {
          width: 100%;
          min-width: 3rem;
          min-height: 3rem;
          padding: 0;
          border-radius: var(--radius--round);
          background-color: currentColor;
          opacity: 0.1;
          pointer-events: none;
        }
        .styleguide_flex_wrap {
          width: 100%;
          aspect-ratio: 1;
          display: flex;
          flex-direction: column;
          container-type: inline-size;
        }
        .styleguide_flex_demo {
          display: flex;
          gap: 26cqw;
          height: 100%;
          width: 100%;
        }
        .styleguide_flex_dot {
          min-width: 16cqw;
          min-height: 16cqw;
          padding: 0;
          border-radius: var(--radius--round);
          background-color: currentColor;
          opacity: 0.1;
          pointer-events: none;
        }
        .styleguide_flex_dot.is-stretch {
          height: 100%;
        }
        .styleguide_swatch {
          width: 100%;
          height: 3rem;
          background-color: currentColor;
        }
        .styleguide_ratio_box {
          width: 100%;
          background-color: currentColor;
        }
        .styleguide_grid_demo {
          width: 100%;
        }
        .styleguide_grid_demo_item {
          width: 100%;
          min-height: 3rem;
          min-width: 1rem;
        }
        .styleguide_row_demo {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          grid-template-rows: repeat(6, minmax(0, 1fr));
          gap: var(--site--gutter);
          width: 100%;
        }
        .styleguide_row_demo_item {
          width: 100%;
          min-width: 1rem;
          min-height: 2rem;
        }
        .styleguide_row_demo_ghost {
          width: 100%;
          grid-column: 2;
          grid-row: 1 / span 6;
        }
        .styleguide_gap_demo {
          display: flex;
          flex-direction: column;
          width: 100%;
        }
        .styleguide_margin_demo {
          width: 100%;
        }
        .styleguide_padding_demo {
          width: 100%;
          background-color: color-mix(in srgb, currentColor 10%, transparent);
        }
        .styleguide_padding_demo_fill {
          background-color: currentColor;
          min-height: 6rem;
        }
        .styleguide_theme_card_content {
          width: 100%;
        }
        .styleguide_richtext_figure {
          margin-top: var(--_spacing---space--5);
          margin-bottom: var(--_spacing---space--5);
          padding: 0;
        }
        .styleguide_richtext_image_placeholder {
          width: 100%;
          aspect-ratio: 16 / 9;
          background-color: var(--_theme---background-skeleton);
          padding: 0;
        }
        .styleguide_footer {
          padding-top: var(--_spacing---section-space--small);
          padding-bottom: var(--_spacing---section-space--small);
          border-top: var(--border-width--main) solid var(--_theme---border);
          text-align: center;
        }
      </style>

      <div class="styleguide_contain u-container">
        <div class="styleguide_layout">
          <nav class="styleguide_nav_wrap" aria-label="Styleguide sections">
            <div class="styleguide_nav_card u-theme-light">
              <ul role="list" class="styleguide_nav_list u-text-style-small">
                {NAV.map((item) => (
                  <li class="styleguide_nav_item">
                    <a href={item.href} class="styleguide_nav_link">{item.label}</a>
                    <ul role="list" class="styleguide_nav_sub_list">
                      {item.subs.map((sub) => (
                        <li>
                          <a href={sub.href} class="styleguide_nav_sub_link">{sub.label}</a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ul>
            </div>
          </nav>

          <div class="styleguide_content">

            <!-- ===================== Typography ===================== -->
            <section id="typography">
              <div class="styleguide_section">
                <h2 class="styleguide_title u-text-style-h2">Typography</h2>

                <div id="text-styles" class="styleguide_group">
                  <h3 class="styleguide_subheading u-text-style-h6">Text Styles</h3>
                  <div class="styleguide_list">
                    {textStyles.map((item) => (
                      <div class="styleguide_font_item">
                        <div class="tag_wrap">{item.cls}</div>
                        <div>
                          {item.tag === 'h1' && <h1 class={item.cls}>{item.text}</h1>}
                          {item.tag === 'h2' && <h2 class={item.cls}>{item.text}</h2>}
                          {item.tag === 'h3' && <h3 class={item.cls}>{item.text}</h3>}
                          {item.tag === 'h4' && <h4 class={item.cls}>{item.text}</h4>}
                          {item.tag === 'h5' && <h5 class={item.cls}>{item.text}</h5>}
                          {item.tag === 'h6' && <h6 class={item.cls}>{item.text}</h6>}
                          {item.tag === 'p' && <p class={item.cls}>{item.text}</p>}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                <div id="weights" class="styleguide_group">
                  <h3 class="styleguide_subheading u-text-style-h6">Weights</h3>
                  <div class="styleguide_scroll">
                    {weights.map((cls) => (
                      <div class="styleguide_card_wrap">
                        <div class="tag_wrap">{cls}</div>
                        <p class={cls}>Lorem ipsum dolor</p>
                      </div>
                    ))}
                  </div>
