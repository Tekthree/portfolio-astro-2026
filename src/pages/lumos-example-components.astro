          .ex_split.is-breakout .ex_split_col2 {
            border-radius: 0;
            overflow: clip;
          }
          .ex_split.is-breakout:not(.is-reverse) .ex_split_col2 {
            margin-right: calc(-1 * var(--site--margin));
            border-top-left-radius: var(--radius--main);
