---
// src/pages/lumos-example-components.astro
// Faithful reproduction of Ryan's Spectacular Site's "Example Components"
// page, sourced from its live published HTML/CSS
// (/tmp/lumos-reference/example-components-live.html + lumos-live.css).
// Not linked from site nav — a verification page proving the Lumos
// foundation layer (src/styles/lumos.css) is bug-free before it's used
// anywhere real. Companion to /lumos-styleguide (Task 6).
//
// Unlike the Styleguide page, this page needed almost no placeholder
// treatment: the ~40 classes excluded from lumos.css (Task 5b) are all
// mode-based Webflow UTILITY classes (u-image, u-svg, u-grid, u-layout,
// u-eyebrow-*, the Button component, etc.) — excluded specifically
// because a styleguide's job is to catalog those exact class names. This
// page instead BUILDS WITH components (Nav, Footer, Button, Card, Tabs,
// Accordion, Grid, Modal, Contact Form) — so instead of writing the
// excluded Webflow class names directly, every one of them is authored
// here as real, hand-written CSS under this page's own component
// classes (ex_*, button_*, card_primary_*, tab_*, accordion_*, nav_*,
// footer_*), using the exact tokens already defined in lumos.css
// (--_theme---button-primary--*, --radius--round, --border-width--main,
// the responsive vars, etc.). Net result: zero placeholder notes on
// this page — see task-7-report.md for the full reasoning.
import BaseLayout from '../layouts/BaseLayout.astro';

const LOREM_LONG =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.';
const LOREM_MED =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam';
const LOREM_SHORT = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod.';
const LOREM_TINY = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et.';

// ---- Nav ----
const NAV_SERVICES_LINKS = ['Branding', 'Website Design', 'Development'];
const NAV_WORK_COLUMNS = [0, 1, 2, 3]; // 4 identical mega-menu columns, matching live source
const NAV_LINKS = ['About', 'Contact'];

// ---- Footer ----
const FOOTER_GROUPS = [
  { title: 'Heading', links: ['Link Text', 'Link Text Here', 'Link Text Goes Here', 'Link Text'] },
  { title: 'Heading Text', links: ['Link Text Here', 'Link Text Goes Here', 'Link Text', 'Link Text Goes Here', 'Link Text Here'] },
  { title: 'Heading Text', links: ['Link Text Goes Here', 'Link Text', 'Link Text Here'] },
  { title: 'Heading', links: ['Link Text Here', 'Link Text', 'Link Text Goes Here', 'Link Text Here'] },
];
const FOOTER_BOTTOM_LINKS = ['Privacy Policy', 'Terms & Conditions', 'Site Map'];
const FOOTER_SOCIALS = ['Facebook', 'Instagram', 'Linked In', 'YouTube', 'X'];

// ---- Tabs ----
const TAB_GENERIC = [1, 2, 3].map((n) => ({ label: `Tab Link ${n}`, heading: `Tab Content ${n}` }));
const TAB_SERVICES = ['Strategy', 'Design', 'Development'];

// ---- Accordion (6 in source, kept at 4 here — see report) ----
const ACCORDION_ITEMS = Array.from({ length: 4 }, () => 'This is some text inside of a div block.');

// ---- Card grids (3 in source: 3/2/1, 3/1/1, 4/2/1 responsive columns) ----
const makeCards = (n: number) => Array.from({ length: n }, () => ({ heading: 'Heading', text: LOREM_SHORT }));
const GRID_1 = makeCards(5);
const GRID_2 = makeCards(4);
const GRID_3 = makeCards(5);

// ---- Slider cards (2 sliders in source) ----
const SLIDER_1 = Array.from({ length: 7 }, () => ({ heading: 'Heading', text: LOREM_SHORT }));
const SLIDER_2 = Array.from({ length: 5 }, () => ({ heading: 'Heading', text: LOREM_SHORT }));

// ---- Contact form select options ----
const STATE_OPTIONS = ['Option 1', 'Option 2', 'Option 3'];

// ---- 10-instance "Layout image-pairing variants" showcase (source: one
// section, 10 back-to-back Layout component instances, each on a real named
// Webflow variant: auto-width, columns, columns-reversed, breakout,
// breakout-reversed, full, full-reversed, contain, contain-reversed, card.
// Every variant reuses this page's existing split/hero/visual primitives
// (ex_split, ex_hero_content, ex_visual, ex_visual_bg) with small modifier
// classes layered on top for the variants whose source CSS visibly differs
// (breakout's edge-bleeding image, contain's boxed card, full's stacked
// full-bleed image, card's faded background-image overlay) — see report.
const SHOWCASE = [
  { variant: 'auto-width', family: 'auto-width' },
  { variant: 'columns', family: 'split', modifier: '' },
  { variant: 'columns-reversed', family: 'split', modifier: '', reverse: true },
  { variant: 'breakout', family: 'split', modifier: 'is-breakout' },
  { variant: 'breakout-reversed', family: 'split', modifier: 'is-breakout', reverse: true },
  { variant: 'full', family: 'full' },
  { variant: 'full-reversed', family: 'full', reverse: true },
  { variant: 'contain', family: 'split', modifier: 'is-contain' },
  { variant: 'contain-reversed', family: 'split', modifier: 'is-contain', reverse: true },
  { variant: 'card', family: 'card' },
];
---
<BaseLayout title="Lumos Example Components (Reference)">
  <div class="page_wrap u-theme-dark">
    <!-- ============================== Nav ============================== -->
    <div class="nav_component">
      <style>
        /* Faithful port of the live reference's nav — sourced directly from its
           real markup and compiled CSS, not reconstructed. Two real, deliberate
           deviations from the general skill rules, both because the reference
           itself works this way:
           1. The open/close state is read straight off `aria-expanded` via
              `:has()` (no JS-driven .is-active class needed for this component —
              a click handler flips aria-expanded, the CSS reacts to it directly).
              This is the actual mechanism the reference's own nav ships with.
           2. `.nav_component` redeclares the `--_theme---*` variables locally
              (matching the reference's own scoped-light-theme technique) rather
              than using the `u-theme-light` utility class, because the nav
              wrapper itself must stay transparent — the visible white surface
              comes from `nav_desktop_contain` / `nav_mobile_layout` picking up
              `--_theme---nav--background`, not from painting the wrapper itself.
        */
        .nav_component {
          --nav--dropdown-open-duration: 400ms;
          --nav--dropdown-close-duration: 400ms;
          --nav--menu-open-duration: 400ms;
          --nav--menu-close-duration: 400ms;
          /* The reference sets position:fixed as an inline style directly on
             this element (overriding a `position: sticky` rule in its own
             compiled CSS) — confirmed from the live page's actual DOM, not
             just its stylesheet. Content below intentionally has no
             compensating top padding; the hero is meant to start behind the
             nav. */
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          z-index: 1000;
          pointer-events: none;
          background-color: transparent;
          color: var(--_theme---text);
          container-type: inline-size;
          --_theme---background: var(--swatch--light-200);
          --_theme---text: var(--swatch--dark-900);
          --_theme---background-2: var(--swatch--light-100);
          --_theme---heading-accent: var(--swatch--brand-600);
          --_theme---border: var(--swatch--dark-900-o20);
          --_theme---nav--background: var(--_theme---background-2);
        }

        .nav_skip_wrap {
          position: absolute;
          top: 0;
          left: 0;
          z-index: 2;
          margin: 0.5rem;
          padding: 0.5rem;
          border: var(--border-width--main) solid var(--_theme---border);
          border-radius: var(--radius--small);
          background-color: var(--_theme---background);
          color: var(--_theme---text);
          pointer-events: auto;
          transform: translate(-200%);
        }
        .nav_skip_wrap:focus {
          transform: translate(0%);
        }

        .nav_desktop_wrap,
        .nav_mobile_wrap {
          position: relative;
          margin-top: var(--site--margin);
          background-color: transparent;
        }
        .nav_desktop_wrap { display: none; }

        .nav_desktop_contain,
        .nav_mobile_layout {
          max-width: var(--max-width--main);
          margin-left: auto;
          margin-right: auto;
          border-radius: var(--radius--small);
          background-color: var(--_theme---nav--background);
          width: calc(100% - var(--site--margin) * 2);
        }
        .nav_desktop_contain {
          padding-left: var(--_spacing---space--5);
          padding-right: var(--_spacing---space--5);
        }
        .nav_desktop_layout,
        .nav_mobile_layout {
          height: 4rem;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: var(--_spacing---space--3);
          pointer-events: auto;
          position: relative;
        }
        .nav_mobile_layout {
          padding: 0 var(--_spacing---space--5);
        }

        .nav_desktop_logo,
        .nav_mobile_logo {
          flex-shrink: 0;
          width: 6rem;
          display: flex;
          align-items: center;
        }
        .nav_logo_svg {
          width: 100%;
          height: auto;
          display: block;
        }
        .nav_logo_path {
          fill: currentColor;
        }

        .nav_links_component {
          flex: 1;
          display: flex;
          flex-direction: row;
        }
        .nav_links_wrap {
          flex: 1;
          display: flex;
          flex-flow: row;
          justify-content: center;
          align-items: stretch;
        }
        .nav_links_item {
          height: 100%;
          position: relative;
        }
        .nav_links_link {
          height: 100%;
          display: flex;
          align-items: center;
          gap: var(--_spacing---space--1);
          padding: 0 var(--_spacing---space--3);
          cursor: pointer;
          color: inherit;
        }
        /* The source path (M17 2L50 35 17 68) is a rightward-pointing arrow —
           the reference rotates it 90deg via a data-wf--icon-arrow--direction
           attribute to point down at rest. Same rotation applied here directly
           since this port has no equivalent attribute-driven variant system. */
        .nav_links_svg {
          width: 1rem;
          aspect-ratio: 1;
          flex-shrink: 0;
          transform: rotate(90deg);
          transition: transform 200ms ease;
        }
        .nav_links_svg svg {
          display: block;
          width: 100%;
          height: 100%;
        }
        .nav_links_svg path {
          stroke: currentColor;
          stroke-width: 2;
          fill: none;
        }
        /* Arrow flips to point up while its dropdown is open — reads
           aria-expanded directly per the reference's own technique.
           270deg = 90deg (rest, pointing down) + 180deg (flip), since
           transform values override rather than compound across rules. */
        .nav_dropdown_component:has(> .nav_links_link[aria-expanded="true"]) .nav_links_svg {
          transform: rotate(270deg);
        }

        .nav_dropdown_component {
          position: static;
        }

        /* Dropdown open/close: grid-template-rows height animation, collapsed
           (0fr) at rest, expands to 1fr when its toggle's aria-expanded is
           true — matches the reference exactly, no JS state class needed. */
        .nav_dropdown_main_wrap,
        .nav_dropdown_mega_wrap {
          display: grid;
          grid-template-rows: 0fr;
          grid-template-columns: minmax(0, 1fr);
          visibility: hidden;
          opacity: 0;
          transition: grid-template-rows var(--nav--dropdown-close-duration);
        }
        .nav_dropdown_component:has(> .nav_links_link[aria-expanded="true"]) .nav_dropdown_main_wrap,
        .nav_dropdown_component:has(> .nav_links_link[aria-expanded="true"]) .nav_dropdown_mega_wrap {
          grid-template-rows: 1fr;
          visibility: visible;
          opacity: 1;
          transition-duration: var(--nav--dropdown-open-duration);
        }
        .nav_dropdown_main_content,
        .nav_dropdown_mega_content {
          overflow: hidden;
        }

        .nav_dropdown_main_wrap {
          position: absolute;
          top: 100%;
          left: 0;
          width: 10rem;
          margin-top: var(--_spacing---space--1);
        }
        .nav_dropdown_mega_wrap {
          position: absolute;
          top: 100%;
          left: 0;
          width: calc(100vw - var(--site--margin) * 2);
          max-width: var(--max-width--main);
          margin-top: var(--_spacing---space--1);
        }
        .nav_dropdown_main_scroll,
        .nav_dropdown_mega_scroll {
          padding: var(--_spacing---space--3);
          border-radius: var(--radius--main);
          border: var(--border-width--main) solid var(--_theme---border);
          background-color: var(--_theme---background-2);
          box-shadow: 0 0.5rem 1.5rem color-mix(in srgb, var(--_theme---text) 15%, transparent);
        }
        .nav_dropdown_mega_layout {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 10rem));
          gap: var(--_spacing---space--6);
        }
        .nav_dropdown_list {
          display: flex;
          flex-direction: column;
          gap: var(--_spacing---space--1);
        }
        .nav_dropdown_link {
          display: block;
          padding: var(--_spacing---space--2);
          border-radius: var(--radius--small);
          color: color-mix(in hsl, var(--_theme---text-link--text) calc(100% * var(--_trigger---on)), var(--_theme---text-link--text-hover) calc(100% * var(--_trigger---off)));
        }

        .nav_actions_wrap {
          flex: none;
          display: flex;
          align-items: center;
          gap: var(--_spacing---space--3);
        }
        .nav_links_text.u-text-transform-uppercase {
          padding: var(--_spacing---space--2);
        }

        .nav_links_search_icon {
          width: 1.1rem;
          aspect-ratio: 1;
        }
        .nav_links_search_icon svg {
          display: block;
          width: 100%;
          height: 100%;
        }
        .nav_links_search_icon path {
          stroke: currentColor;
          fill: none;
        }
        .nav_search_wrap {
          display: flex;
          align-items: center;
          border-bottom: var(--border-width--main) solid var(--_theme---border);
        }
        .nav_search_btn_wrap {
          display: flex;
          align-items: center;
          justify-content: center;
          padding: var(--_spacing---space--2);
        }
        .nav_search_btn_icon {
          width: 1.1rem;
          aspect-ratio: 1;
        }
        .nav_search_btn_icon circle,
        .nav_search_btn_icon path {
          stroke: currentColor;
          fill: none;
        }
        .nav_search_field {
          width: 16rem;
          max-width: 60vw;
          height: 2.9em;
          background: transparent;
          border: none;
          color: inherit;
          font-size: 1rem;
        }
        .nav_search_field::placeholder {
          color: color-mix(in srgb, var(--_theme---text) 60%, transparent);
        }

        /* Button component — minimal, scoped to just what this nav needs
           (the two nav_buttons_item instances). The full Button system was
           deliberately excluded from the shared foundation layer (2026-07-07
           decision), but the real nav markup uses it, so it's built here,
           local to the nav, rather than skipped. */
        .nav_buttons_item {
          position: relative;
        }
        /* .button_main_wrap is just the rounded-corner clipping shell — all
           real visual styling (border, background, padding) lives on
           .button_main_element, a nested element this port initially left
           out entirely, which is why colors/size were wrong: the wrapper
           alone carries none of the actual button skin. */
        .button_main_wrap {
          position: relative;
          display: inline-block;
          border-radius: var(--radius--round);
        }
        .button_main_element {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.5rem;
          height: 100%;
          padding: 0.9rem 1.5rem;
          line-height: 1;
          text-align: center;
          border-radius: inherit;
          border: var(--border-width--main) solid color-mix(in srgb, var(--_theme---button-primary--border) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--border-hover) calc(100% * var(--_trigger---off)));
          color: color-mix(in srgb, var(--_theme---button-primary--text) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--text-hover) calc(100% * var(--_trigger---off)));
          background-color: color-mix(in srgb, var(--_theme---button-primary--background) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--background-hover) calc(100% * var(--_trigger---off)));
          transition: all 200ms ease;
          position: relative;
        }
        .button_main_element.is-secondary {
          border-color: color-mix(in srgb, var(--_theme---button-secondary--border) calc(100% * var(--_trigger---on)), var(--_theme---button-secondary--border-hover) calc(100% * var(--_trigger---off)));
          color: color-mix(in srgb, var(--_theme---button-secondary--text) calc(100% * var(--_trigger---on)), var(--_theme---button-secondary--text-hover) calc(100% * var(--_trigger---off)));
          background-color: color-mix(in srgb, var(--_theme---button-secondary--background) calc(100% * var(--_trigger---on)), var(--_theme---button-secondary--background-hover) calc(100% * var(--_trigger---off)));
        }
        .clickable_wrap {
          position: absolute;
          inset: 0;
        }
        .clickable_btn {
          width: 100%;
          height: 100%;
        }

        .nav_mobile_menu_wrap {
          display: none;
        }
        .nav_button_wrap {
          flex-shrink: 0;
          width: 2rem;
          aspect-ratio: 1;
          display: none;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          gap: var(--_spacing---space--2);
          pointer-events: auto;
        }
        .nav_button_line {
          width: 100%;
          height: var(--border-width--main);
          background-color: currentColor;
          transition: transform 200ms ease;
        }
        .nav_component:has(.nav_button_wrap[aria-expanded="true"]) .nav_button_line.is-1 {
          transform: translateY(calc(var(--_spacing---space--2) * 0.5 + 0.047rem)) rotate(45deg);
        }
        .nav_component:has(.nav_button_wrap[aria-expanded="true"]) .nav_button_line.is-2 {
          transform: translateY(calc(var(--_spacing---space--2) * -0.5 - 0.047rem)) rotate(-45deg);
        }

        .nav_dropdown_backdrop,
        .nav_menu_backdrop {
          position: fixed;
          inset: 0;
          z-index: 0;
          width: 100%;
          height: 100vh;
          opacity: 0;
          pointer-events: none;
          background-color: color-mix(in srgb, var(--swatch--dark-900) 20%, transparent);
          transition: opacity var(--nav--dropdown-close-duration);
        }
        .nav_component:has(.nav_dropdown_component > .nav_links_link[aria-expanded="true"]) .nav_dropdown_backdrop {
          opacity: 1;
        }
        .nav_component:has(.nav_button_wrap[aria-expanded="true"]) .nav_menu_backdrop {
          opacity: 1;
        }

        /* Desktop <-> mobile switch at the reference's real 65em breakpoint.
           @container is the documented escape hatch: a pure structural
           swap (two entirely different trees shown/hidden) can't be
           expressed by the responsive keyword variables. */
        @container (min-width: 65em) {
          .nav_desktop_wrap { display: block; }
          .nav_mobile_wrap { display: none; }
        }
        @container (width < 65em) {
          .nav_component:has(.nav_button_wrap[aria-expanded="true"]) .nav_mobile_menu_wrap {
            display: block;
          }
          .nav_button_wrap { display: flex; }
          .nav_links_component { flex-direction: column; padding: var(--_spacing---space--3) 0; }
          .nav_links_wrap { flex-direction: column; align-items: stretch; width: 100%; }
          .nav_links_link { padding: var(--_spacing---space--3) var(--_spacing---space--5); }
          .nav_dropdown_main_wrap,
          .nav_dropdown_mega_wrap { position: static; width: 100%; margin-top: 0; }
          .nav_dropdown_mega_layout { grid-template-columns: minmax(0, 1fr); }
          .nav_dropdown_main_scroll,
          .nav_dropdown_mega_scroll { border: none; border-radius: 0; box-shadow: none; padding: 0 var(--_spacing---space--5); }
          .nav_actions_wrap { flex-direction: column; align-items: stretch; padding: var(--_spacing---space--3) var(--_spacing---space--5); gap: var(--_spacing---space--4); }
          .nav_buttons_item { margin-top: var(--_spacing---space--3); }
        }
      </style>

      <a class="nav_skip_wrap" href="#main">Skip to main content</a>

      <header class="nav_desktop_wrap">
        <div class="nav_desktop_contain">
          <div class="nav_desktop_layout">
            <a aria-label="Home Page" class="nav_desktop_logo" href="/">
              <svg class="nav_logo_svg" fill="none" viewBox="0 0 908 184" xmlns="http://www.w3.org/2000/svg">
                <path class="nav_logo_path" d="M176.11 120.7L119.28 105.47L134.5 162.3L106.42 169.82L91.19 113.01L20.56 183.63L0 163.07L70.63 92.44L13.81 77.22L21.33 49.13L78.16 64.36L62.93 7.53L91.02 0L106.25 56.83L148.86 14.21L169.42 34.77L126.81 77.39L183.63 92.62L176.11 120.7Z"></path>
                <path class="nav_logo_path" d="M224.24 174.1V7.62988H255.87V146.75H333.63V174.1H224.24Z"></path>
                <path class="nav_logo_path" d="M455.47 54.2402V174.1H426.22V155.55C419.56 168.63 406.01 176 388.88 176C362.01 176 344.41 156.5 344.41 128.44V54.2402H373.42V122.25C373.42 138.66 383.65 150.07 398.39 150.07C414.8 150.07 426.21 137.23 426.21 119.63V54.2402H455.46H455.47Z"></path>
                <path class="nav_logo_path" d="M676.2 114.17C676.2 78.5003 702.36 52.3403 738.98 52.3403C775.6 52.3403 801.52 78.5003 801.52 114.17C801.52 149.84 775.36 176 738.98 176C702.6 176 676.2 149.84 676.2 114.17ZM772.04 114.17C772.04 92.5303 758.72 77.5503 738.98 77.5503C719.24 77.5503 705.69 92.5303 705.69 114.17C705.69 135.81 719.01 150.79 738.98 150.79C758.95 150.79 772.04 135.81 772.04 114.17Z"></path>
              </svg>
            </a>

            <nav aria-label="Main" class="nav_links_component">
              <div role="list" class="nav_links_wrap">
                <div role="listitem" class="nav_links_item">
                  <div class="nav_dropdown_component">
                    <div aria-controls="nav-dd-services" aria-expanded="false" aria-haspopup="menu" class="nav_links_link" id="nav-toggle-services" role="button" tabindex="0">
                      <div class="nav_links_text">Services</div>
                      <div class="nav_links_svg"><svg viewBox="0 0 66 70"><path d="M17 2L50 35 17 68"></path></svg></div>
                    </div>
                    <nav class="nav_dropdown_main_wrap" id="nav-dd-services" aria-labelledby="nav-toggle-services">
                      <div class="nav_dropdown_main_content">
                        <div class="nav_dropdown_main_scroll">
                          <ul role="list" class="nav_dropdown_list">
                            {NAV_SERVICES_LINKS.map((label) => (
                              <li class="nav_dropdown_item"><a class="nav_dropdown_link" data-trigger="hover focus" href="#">{label}</a></li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </nav>
                  </div>
                </div>
                <div role="listitem" class="nav_links_item">
                  <div class="nav_dropdown_component">
                    <div aria-controls="nav-dd-work" aria-expanded="false" aria-haspopup="menu" class="nav_links_link" id="nav-toggle-work" role="button" tabindex="0">
                      <div class="nav_links_text">Work</div>
                      <div class="nav_links_svg"><svg viewBox="0 0 66 70"><path d="M17 2L50 35 17 68"></path></svg></div>
                    </div>
                    <nav class="nav_dropdown_mega_wrap" id="nav-dd-work" aria-labelledby="nav-toggle-work">
                      <div class="nav_dropdown_mega_content">
                        <div class="nav_dropdown_mega_scroll">
                          <div class="nav_dropdown_mega_layout">
                            {NAV_WORK_COLUMNS.map(() => (
                              <ul role="list" class="nav_dropdown_list">
