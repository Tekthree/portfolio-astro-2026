      <script>
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('.nav_component').forEach((nav) => {
            if (nav.dataset.scriptInitialized) return;
            nav.dataset.scriptInitialized = 'true';

            // Dropdown toggles: click flips aria-expanded, CSS :has() does
            // the rest. Only one open at a time within the same tree.
            nav.querySelectorAll('.nav_dropdown_component > [aria-controls]').forEach((btn) => {
              btn.addEventListener('click', () => {
                const open = btn.getAttribute('aria-expanded') === 'true';
                btn.closest('.nav_links_wrap')?.querySelectorAll('.nav_dropdown_component > [aria-controls]').forEach((other) => {
                  if (other !== btn) other.setAttribute('aria-expanded', 'false');
                });
                btn.setAttribute('aria-expanded', String(!open));
              });
            });

            // Mobile hamburger toggle
            const menuToggle = nav.querySelector('.nav_button_wrap');
            menuToggle?.addEventListener('click', () => {
              const open = menuToggle.getAttribute('aria-expanded') === 'true';
              menuToggle.setAttribute('aria-expanded', String(!open));
            });
          });
        });
      </script>
