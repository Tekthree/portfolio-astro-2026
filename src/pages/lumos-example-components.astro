                  });
                  btn.classList.add('is-active');
                  btn.setAttribute('aria-selected', 'true');
                  btn.removeAttribute('data-state');
                  const activePanel = tabs.querySelector('[data-panel-id="' + btn.getAttribute('aria-controls') + '"]');
