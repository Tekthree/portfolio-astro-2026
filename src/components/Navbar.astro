---
---
<div class="nav-divider" style="position:fixed;top:0;left:0;right:0;z-index:1000;"></div>
<nav style="
  position: fixed;
  top: 1px;
  left: 0;
  right: 0;
  z-index: 999;
  padding: 2.9em 6vw;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(to bottom, rgba(7,4,25,0.85) 0%, transparent 100%);
">
  <a href="/" style="display:flex;align-items:center;gap:0.75em;text-decoration:none;">
    <img src="/assets/images/61ccd624703169e41884b4cf_logo3.avif" alt="Pixel Jones" style="height:3.5em;width:auto;" />
    <div style="font-family:Mortend,sans-serif;font-size:1.1em;font-weight:800;color:var(--font-light);line-height:1;letter-spacing:0.05em;text-transform:uppercase;">pixel<br>JONES</div>
  </a>

  <button id="menu-btn" style="background:none;border:none;cursor:pointer;padding:0.5em;display:flex;flex-direction:column;gap:5px;" aria-label="Menu">
    <span style="display:block;width:1.5em;height:2px;background:var(--font-light);"></span>
    <span style="display:block;width:1.5em;height:2px;background:var(--font-light);"></span>
  </button>
</nav>

<div id="nav-overlay" style="position:fixed;inset:0;z-index:998;background:rgba(7,4,25,0.97);display:none;flex-direction:column;align-items:center;justify-content:center;gap:3em;">
  <button id="menu-close" style="position:absolute;top:2em;right:2em;background:none;border:none;cursor:pointer;color:var(--font-light);font-size:2em;">×</button>
  <a href="#work" onclick="document.getElementById('nav-overlay').style.display='none'" style="font-family:Mortend,sans-serif;font-size:3em;font-weight:800;letter-spacing:0.05em;text-transform:uppercase;color:var(--font-light);">WORK</a>
  <a href="#about" onclick="document.getElementById('nav-overlay').style.display='none'" style="font-family:Mortend,sans-serif;font-size:3em;font-weight:800;letter-spacing:0.05em;text-transform:uppercase;color:var(--font-light);">ABOUT</a>
  <a href="https://linkedin.com/in/ryan-jones-54b39562" target="_blank" style="font-family:Mortend,sans-serif;font-size:3em;font-weight:800;letter-spacing:0.05em;text-transform:uppercase;color:var(--font-light);">RESUME</a>
</div>

<script>
  const btn = document.getElementById('menu-btn');
  const overlay = document.getElementById('nav-overlay');
  const close = document.getElementById('menu-close');
  btn?.addEventListener('click', () => { overlay.style.display = 'flex'; });
  close?.addEventListener('click', () => { overlay.style.display = 'none'; });
</script>
