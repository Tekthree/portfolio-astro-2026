---
---
<div id="top" class="navbar_component u-theme-dark">
  <header class="navbar_desktop_wrap">
    <div class="navbar_desktop_contain">
      <div class="navbar_desktop_layout">
        <a href="/" aria-label="Home" class="navbar_logo_wrap">
          <img src="/assets/images/61ccd624703169e41884b4cf_logo3.avif" alt="Pixel Jones" class="navbar_logo_icon" />
          <div class="navbar_logo_text u-text-style-small">pixel<br>JONES</div>
        </a>

        <nav aria-label="Main" class="navbar_links_component">
          <div role="list" class="navbar_links_wrap">
            <div role="listitem" class="navbar_links_item">
              <a href="/#work" class="navbar_links_link u-text-style-small">Work</a>
            </div>
            <div role="listitem" class="navbar_links_item">
              <a href="/#about" class="navbar_links_link u-text-style-small">About</a>
            </div>
            <div role="listitem" class="navbar_links_item">
              <a href="/#contact" class="navbar_links_link u-text-style-small">Contact</a>
            </div>
          </div>
        </nav>

        <div class="navbar_actions u-button-wrapper">
          <a href="#book" data-book-cta data-trigger="hover focus" class="navbar_button navbar_button--cta">
            <svg class="navbar_button_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.09 4.18 2 2 0 0 1 4.08 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.33 1.85.56 2.81.69A2 2 0 0 1 22 16.92z"/>
            </svg>
            Book a call
          </a>
        </div>
      </div>
    </div>
  </header>

  <header class="navbar_mobile_wrap">
    <div class="navbar_mobile_contain">
      <div class="navbar_mobile_layout">
        <a href="/" aria-label="Home" class="navbar_logo_wrap">
          <img src="/assets/images/61ccd624703169e41884b4cf_logo3.avif" alt="Pixel Jones" class="navbar_logo_icon" />
          <div class="navbar_logo_text u-text-style-small">pixel<br>JONES</div>
        </a>

        <button
          type="button"
          id="navbar-mobile-toggle"
          aria-expanded="false"
          aria-controls="navbar-mobile-menu"
          aria-label="Menu"
          class="navbar_menu_btn"
        >
          <span class="navbar_menu_line"></span>
          <span class="navbar_menu_line"></span>
        </button>
      </div>
    </div>

    <nav
      id="navbar-mobile-menu"
      aria-labelledby="navbar-mobile-toggle"
      class="navbar_mobile_menu_wrap"
    >
      <!-- The opaque full-screen overlay below paints over the header bar entirely,
           hiding the hamburger button that opened it (same DOM stacking context,
           later in source order, no z-index difference) -- there was no visible way
           to close the menu at all before this. A dedicated close button inside the
           overlay itself is more robust than relying on the hamburger visually
           morphing into an X, since nothing else covers this position. -->
      <button type="button" id="navbar-mobile-close" aria-label="Close menu" class="navbar_menu_close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 5l14 14M19 5 5 19"/></svg>
      </button>
      <div role="list" class="navbar_mobile_menu_layout">
        <div role="listitem" class="navbar_links_item">
          <a href="/#work" class="navbar_mobile_link u-text-style-h4">Work</a>
        </div>
        <div role="listitem" class="navbar_links_item">
          <a href="/#about" class="navbar_mobile_link u-text-style-h4">About</a>
        </div>
        <div role="listitem" class="navbar_links_item">
          <a href="/#contact" class="navbar_mobile_link u-text-style-h4">Contact</a>
        </div>
        <div role="listitem" class="navbar_links_item navbar_actions u-button-wrapper">
          <a href="#book" data-book-cta data-trigger="hover focus" class="navbar_button navbar_button--cta">
            <svg class="navbar_button_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.09 4.18 2 2 0 0 1 4.08 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.33 1.85.56 2.81.69A2 2 0 0 1 22 16.92z"/>
            </svg>
            Book a call
          </a>
        </div>
      </div>
    </nav>
  </header>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".navbar_component").forEach((component) => {
    if (component.dataset.scriptInitialized) return;
    component.dataset.scriptInitialized = "true";

    const toggle = component.querySelector("#navbar-mobile-toggle");
    const menu = component.querySelector("#navbar-mobile-menu");
    const closeBtn = component.querySelector("#navbar-mobile-close");

    toggle?.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
    });

    closeBtn?.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
    });

    menu?.querySelectorAll(".navbar_mobile_link, .navbar_button").forEach((link) => {
      link.addEventListener("click", () => {
        toggle?.setAttribute("aria-expanded", "false");
      });
    });

    // The [data-book-cta] scroll handler lives in BaseLayout as one delegated
    // document listener, so it covers the hero CTA and anything added later too.
    // The menu-close above already fires for this button via .navbar_button.

    // Nav's flow height depends on fluid tokens, breakpoint tree switches, and
    // border-box padding math — too error-prone to hand-compute in CSS. Measuring
    // the real rendered height and exposing it as a variable keeps Hero's
    // compensating negative margin exactly correct at every viewport.
    const setNavHeightVar = () => {
      document.documentElement.style.setProperty("--nav--actual-height", component.offsetHeight + "px");
    };
    setNavHeightVar();
    window.addEventListener("resize", setNavHeightVar);
  });
});
</script>

<style>
.navbar_component {
  position: sticky;
  top: 0;
  z-index: 1000;
  pointer-events: none;
  /* padding, not margin — a margin-top on the wrap child would collapse through this
     sticky element (no padding/border of its own to block it), so the whole contained
     box would snap flush the moment it becomes stuck on scroll. Padding never collapses. */
  padding-top: var(--site--margin);
  /* u-theme-dark sets background-color as a side effect of providing the theme
     variables (text/button colors) — this element is a transparent overlay, not a
     themed section, so that background needs an explicit override. */
  background-color: transparent;
}

.navbar_desktop_wrap {
  display: flex;
  flex-direction: column;
  position: relative;
}

@container (width < 992px) {
  .navbar_desktop_wrap { display: none; }
}

.navbar_desktop_contain {
  max-width: var(--max-width--main);
  width: calc(100% - var(--site--margin) * 2);
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--_spacing---space--5);
  padding-right: var(--_spacing---space--5);
  border-radius: var(--radius--small);
  background-color: color-mix(in srgb, var(--swatch--nav-bg) 75%, transparent);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.navbar_desktop_layout {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--_spacing---space--4);
  min-height: var(--nav--height-total);
  padding-top: var(--_spacing---space--3);
  padding-bottom: var(--_spacing---space--3);
  max-width: var(--max-width--main);
  margin-left: auto;
  margin-right: auto;
  pointer-events: auto;
}

.navbar_logo_wrap {
  display: flex;
  align-items: center;
  gap: var(--_spacing---space--2);
  flex-shrink: 0;
}

.navbar_logo_icon {
  height: 3.5em;
  width: auto;
  aspect-ratio: auto;
  object-fit: contain;
}

.navbar_logo_text {
  font-family: var(--_typography---font--heading-family);
  font-weight: var(--_typography---font--primary-bold);
  color: var(--_theme---text);
  line-height: 1;
  letter-spacing: var(--_typography---letter-spacing--tight);
  text-transform: uppercase;
}

.navbar_links_component {
  display: block;
}

.navbar_links_wrap {
  display: flex;
  align-items: center;
  gap: var(--_spacing---space--5);
}

.navbar_links_item {
  display: block;
}

.navbar_links_link {
  color: color-mix(in hsl, var(--_theme---text) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--background) calc(100% * var(--_trigger---off)));
  text-transform: uppercase;
  letter-spacing: var(--_typography---letter-spacing--tight);
  transition: color 200ms;
}

.navbar_actions {
  display: flex;
  flex-shrink: 0;
}

.navbar_button {
  padding: var(--_spacing---space--3) var(--_spacing---space--5);
  border-radius: var(--radius--round);
  border-width: var(--border-width--main);
  border-style: solid;
  text-transform: uppercase;
  letter-spacing: var(--_typography---letter-spacing--tight);
  background-color: color-mix(in hsl, var(--_theme---button-primary--background) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--background-hover) calc(100% * var(--_trigger---off)));
  color: color-mix(in hsl, var(--_theme---button-primary--text) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--text-hover) calc(100% * var(--_trigger---off)));
  border-color: color-mix(in hsl, var(--_theme---button-primary--border) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--border-hover) calc(100% * var(--_trigger---off)));
  transition: all 200ms;
}

/* Icon + label need to sit on one baseline-ish row. The base .navbar_button is a
   plain inline anchor, so this only applies to the CTA variant and leaves every
   other use of the class untouched. */
.navbar_button--cta {
  display: inline-flex;
  align-items: center;
  gap: 0.55em;
  white-space: nowrap;
}

.navbar_button_icon {
  width: 1.05em;
  height: 1.05em;
  flex: none;
  /* nudge: the handset glyph reads slightly high against uppercase text */
  transform: translateY(0.5px);
}

.navbar_mobile_wrap {
  display: none;
  flex-direction: column;
  position: relative;
}

@container (width < 992px) {
  .navbar_mobile_wrap { display: flex; }
}

.navbar_mobile_contain {
  max-width: var(--max-width--main);
  width: calc(100% - var(--site--margin) * 2);
  margin-left: auto;
  margin-right: auto;
}

.navbar_mobile_layout {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--nav--height-total);
  padding-top: var(--_spacing---space--3);
  padding-bottom: var(--_spacing---space--3);
  padding-left: var(--_spacing---space--5);
  padding-right: var(--_spacing---space--5);
  border-radius: var(--radius--small);
  background-color: color-mix(in srgb, var(--swatch--nav-bg) 75%, transparent);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  pointer-events: auto;
}

.navbar_menu_btn {
  display: flex;
  flex-direction: column;
  gap: var(--_spacing---space--1);
  padding: var(--_spacing---space--2);
}

.navbar_menu_line {
  display: block;
  width: 1.5em;
  height: var(--border-width--main);
  background-color: var(--_theme---text);
}

.navbar_menu_close {
  position: absolute;
  top: var(--_spacing---space--5);
  right: var(--site--margin);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.75em;
  height: 2.75em;
  border-radius: var(--radius--round);
  border: 2px solid color-mix(in srgb, var(--swatch--muted-500), white 20%);
  background: transparent;
  color: var(--_theme---text);
  cursor: pointer;
  transition: border-color 200ms;
}

.navbar_menu_close svg { width: 1.1em; height: 1.1em; }

.navbar_menu_close:hover { border-color: var(--swatch--accent-500); }

.navbar_mobile_menu_wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: auto;
  visibility: hidden;
  opacity: 0;
  transition: opacity 400ms, visibility 400ms;
  background-color: var(--_theme---background);
}

.navbar_mobile_wrap:has(#navbar-mobile-toggle[aria-expanded="true"]) .navbar_mobile_menu_wrap {
  visibility: visible;
  opacity: 1;
}

.navbar_mobile_menu_layout {
  height: 100%;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--_spacing---space--5);
  padding: var(--_spacing---space--8);
}

.navbar_mobile_link {
  color: var(--_theme---text);
  text-transform: uppercase;
  letter-spacing: var(--_typography---letter-spacing--tight);
}
</style>
