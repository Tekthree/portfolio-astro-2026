---
---
<footer style="background-color:var(--ashy-black);">
  <div style="max-width:100em;margin:0 auto;padding:9.8em 6em 0;">

    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:5.4em;">
      <div style="max-width:54.2em;">
        <h1 style="
          font-family:Mortend,sans-serif;
          font-weight:800;
          font-size:5.2em;
          line-height:1.2;
          color:var(--font-light);
          text-transform:uppercase;
          margin:0;
        ">Let's work together</h1>
      </div>
      <span style="font-size:3em;color:var(--font-light);opacity:0.5;">↙</span>
    </div>

    <div class="nav-divider"></div>

    <!-- contact detail pills -->
    <div style="margin-top:5.24em;">
      <a href="mailto:tekthree@gmail.com" style="
        display:inline-block;
        border:2px solid var(--plum-lighter);
        border-radius:100px;
        padding:2.05em 6.35em;
        font-family:Poppins,sans-serif;
        font-size:1.9em;
        font-weight:500;
        color:var(--font-light);
        text-decoration:none;
        white-space:nowrap;
        margin-right:3.19em;
      ">tekthree@gmail.com</a>
      <a href="tel:7206565560" style="
        display:inline-block;
        border:2px solid var(--plum-lighter);
        border-radius:100px;
        padding:2.05em 6.35em;
        font-family:Poppins,sans-serif;
        font-size:1.9em;
        font-weight:500;
        color:var(--font-light);
        text-decoration:none;
        white-space:nowrap;
      ">720-656-5560</a>
    </div>

    <!-- social/version row -->
    <div style="display:flex;margin-top:6.31em;margin-bottom:8.01em;">
      <!-- left -->
      <div style="flex:1;display:flex;gap:4em;">
        <div>
          <p style="color:#5a337a;letter-spacing:0.04em;text-transform:uppercase;font-size:1.1em;font-family:Poppins,sans-serif;font-weight:800;margin:0 0 0.5em;">version</p>
          <p style="font-size:1.5em;font-weight:400;color:var(--font-light);margin:0;letter-spacing:0.03em;">1.0 EDITION ©️ 2022</p>
        </div>
        <div>
          <p style="color:#5a337a;letter-spacing:0.04em;text-transform:uppercase;font-size:1.1em;font-family:Poppins,sans-serif;font-weight:800;margin:0 0 0.5em;">local time</p>
          <p id="local-time" style="font-size:1.5em;font-weight:400;color:var(--font-light);margin:0;letter-spacing:0.03em;">—</p>
        </div>
      </div>

      <!-- right -->
      <div style="flex:1;">
        <p style="color:#5a337a;letter-spacing:0.04em;text-transform:uppercase;font-size:1.1em;font-family:Poppins,sans-serif;font-weight:800;margin:0 0 0.5em;">socials</p>
        <div style="display:flex;gap:0;">
          <a href="https://www.linkedin.com/in/ryan-jones-54b39562/" target="_blank" style="font-size:1.5em;font-weight:400;color:var(--font-light);margin-right:1.75em;text-decoration:none;letter-spacing:0.03em;">LinkedIn</a>
          <a href="https://github.com/Tekthree" target="_blank" style="font-size:1.5em;font-weight:400;color:var(--font-light);margin-right:1.75em;text-decoration:none;letter-spacing:0.03em;">GitHub</a>
        </div>
      </div>
    </div>

  </div>
</footer>

<script>
  const el = document.getElementById('local-time');
  if (el) {
    const update = () => {
      const now = new Date();
      el.textContent = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZoneName: 'short', timeZone: 'America/Los_Angeles' });
    };
    update();
    setInterval(update, 60000);
  }
</script>
