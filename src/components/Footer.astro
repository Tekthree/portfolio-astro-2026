---
---
<footer class="footer-sec">
  <div class="footer-container">

    <div class="footer-head">
      <div class="footer-title-wrap">
        <h1 class="footer-title">Let's work together</h1>
      </div>
      <span class="footer-arrow">↙</span>
    </div>

    <div class="nav-divider"></div>

    <!-- contact pills -->
    <div class="footer-pills">
      <a href="mailto:tekthree@gmail.com" class="footer-pill">tekthree@gmail.com</a>
      <a href="tel:7206565560" class="footer-pill">720-656-5560</a>
    </div>

    <!-- social/version row -->
    <div class="footer-meta">
      <div class="footer-meta-left">
        <div class="footer-meta-col">
          <p class="footer-meta-label">version</p>
          <p class="footer-meta-value">1.0 EDITION ©️ 2022</p>
        </div>
        <div class="footer-meta-col">
          <p class="footer-meta-label">local time</p>
          <p id="local-time" class="footer-meta-value">—</p>
        </div>
      </div>
      <div class="footer-meta-divider"></div>
      <div class="footer-meta-right">
        <p class="footer-meta-label">socials</p>
        <div class="footer-socials">
          <a href="https://www.linkedin.com/in/ryan-jones-54b39562/" target="_blank" class="footer-social-link">LinkedIn</a>
          <a href="https://github.com/Tekthree" target="_blank" class="footer-social-link">GitHub</a>
        </div>
      </div>
    </div>

  </div>
</footer>

<script>
  const el = document.getElementById('local-time');
  if (el) {
    const update = () => {
      el.textContent = new Date().toLocaleTimeString('en-US', {
        hour: 'numeric', minute: '2-digit', timeZoneName: 'short', timeZone: 'America/Los_Angeles'
      });
    };
    update();
    setInterval(update, 60000);
  }
</script>

<style>
.footer-sec {
  background-color: var(--ashy-black);
}

.footer-container {
  max-width: 100em;
  margin: 0 auto;
  padding: 9.8em 6em 0;
}

.footer-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 5.4em;
}

.footer-title-wrap { max-width: 54.2em; }

.footer-title {
  font-family: Mortend, sans-serif;
  font-weight: 800;
  font-size: 5.2em;
  line-height: 1.2;
  color: var(--font-light);
  text-transform: uppercase;
  margin: 0;
}

.footer-arrow {
  font-size: 3em;
  color: var(--font-light);
  opacity: 0.5;
}

/* contact pills — Webflow uses margin-right: 3.19em on each pill */
.footer-pills {
  margin-top: 5.24em;
  display: flex;
  flex-wrap: wrap;
}

.footer-pill {
  display: inline-block;
  border: 2px solid var(--plum-lighter);
  border-radius: 100px;
  /* Webflow: padding on outer wrap (2.05em 6.35em at 16px) + font-size 1.9em on inner p.
     Combined on same element: divide padding by 1.9 to cancel the em-compounding. */
  padding: 1.08em 3.34em;
  margin-right: 3.19em;
  font-family: Poppins, sans-serif;
  font-size: 1.9em;
  font-weight: 500;
  color: var(--font-light);
  text-decoration: none;
  white-space: nowrap;
}

/* meta row */
.footer-meta {
  display: flex;
  margin-top: 6.31em;
  margin-bottom: 8.01em;
}

.footer-meta-left {
  flex: 1;
  display: flex;
  gap: 4em;
}

.footer-meta-right { flex: 1; }

.footer-meta-label {
  color: #5a337a;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-size: 1.1em;
  font-family: Poppins, sans-serif;
  font-weight: 800;
  margin: 0 0 0.5em;
}

.footer-meta-value {
  font-size: 1.5em;
  font-weight: 400;
  color: var(--font-light);
  margin: 0;
  letter-spacing: 0.03em;
}

.footer-socials { display: flex; gap: 0; }

.footer-social-link {
  font-size: 1.5em;
  font-weight: 400;
  color: var(--font-light);
  margin-right: 1.75em;
  text-decoration: none;
  letter-spacing: 0.03em;
}

/* Divider between meta-left and meta-right (hidden at desktop, shown at tablet) */
.footer-meta-divider {
  display: none;
  background-color: var(--submt-purple);
  width: 100%;
  height: 3px;
}

/* Tablet — pill sizes auto-shrink from global font-size:14px */
@media screen and (max-width: 991px) {
  .footer-container { padding: 6em 6vw 0; }
  .footer-title { font-size: 3.9em; }
  .footer-meta-divider { display: block; }
  .footer-meta { flex-wrap: wrap; }
  .footer-meta-left { width: 100%; }
  .footer-meta-right { width: 100%; }
}

/* Mobile */
@media screen and (max-width: 767px) {
  .footer-container { padding: 4em 5vw 0; }
  .footer-title { font-size: 2.9em; }
  .footer-head  { margin-bottom: 3em; }
  .footer-pills { flex-direction: column; gap: 1em; align-items: flex-start; }
  .footer-pill  { white-space: normal; }
  .footer-meta  { flex-direction: column; gap: 2em; margin-top: 3em; margin-bottom: 4em; }
  .footer-meta-left { flex-direction: column; gap: 1.5em; }
  .footer-arrow { font-size: 2em; }
}

/* Small mobile */
@media screen and (max-width: 479px) {
  .footer-title { font-size: 2.7em; }
  .footer-pills { margin-top: 4.14em; }
  .footer-pill  { font-size: 1.5em; padding-left: 1em; padding-right: 1em; }
}
</style>
