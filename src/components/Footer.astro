---
---
<footer class="footer-sec">
  <div class="footer-container">

    <div class="footer-head">
      <div class="footer-title-wrap">
        <h1 class="footer-title u-text-style-h1">Let's work together</h1>
      </div>
      <span class="footer-arrow">↙</span>
    </div>

    <div class="nav-divider"></div>

    <!-- contact pills -->
    <div class="footer-pills">
      <a href="mailto:tekthree@gmail.com" class="footer-pill">tekthree@gmail.com</a>
      <a href="tel:7206565560" class="footer-pill">720-656-5560</a>
    </div>

    <!-- social/version row -->
    <div class="footer-meta">
      <div class="footer-meta-left">
        <div class="footer-meta-col">
          <p class="footer-meta-label">version</p>
          <p class="footer-meta-value">1.0 EDITION ©️ 2022</p>
        </div>
        <div class="footer-meta-col">
          <p class="footer-meta-label">local time</p>
          <p id="local-time" class="footer-meta-value">—</p>
        </div>
      </div>
      <div class="footer-meta-divider"></div>
      <div class="footer-meta-right">
        <p class="footer-meta-label">socials</p>
        <div class="footer-socials">
          <a href="https://www.linkedin.com/in/ryan-jones-54b39562/" target="_blank" class="footer-social-link">LinkedIn</a>
          <a href="https://github.com/Tekthree" target="_blank" class="footer-social-link">GitHub</a>
        </div>
      </div>
    </div>

  </div>
</footer>

<script>
  const el = document.getElementById('local-time');
  if (el) {
    const update = () => {
      el.textContent = new Date().toLocaleTimeString('en-US', {
        hour: 'numeric', minute: '2-digit', timeZoneName: 'short', timeZone: 'America/Los_Angeles'
      });
    };
    update();
    setInterval(update, 60000);
  }
</script>

<style>
.footer-sec {
  background-color: var(--swatch--dark-800);
}

.footer-container {
  max-width: var(--max-width--main);
  margin: 0 auto;
  padding-top: var(--_spacing---section-space--large);
  padding-left: var(--site--margin);
  padding-right: var(--site--margin);
  padding-bottom: var(--_spacing---section-space--main);
}

.footer-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: var(--_spacing---section-space--small);
}

.footer-title-wrap { max-width: 54.2em; }

.footer-title {
  font-family: var(--_typography---font--heading-family);
  color: var(--swatch--light-100);
  margin: 0;
}

.footer-arrow {
  font-size: 3em;
  color: var(--swatch--light-100);
  opacity: 0.5;
}

/* contact pills */
.footer-pills {
  margin-top: var(--_spacing---section-space--small);
  display: flex;
  flex-wrap: wrap;
}

.footer-pill {
  display: inline-block;
  border: 2px solid color-mix(in srgb, var(--swatch--muted-500), white 20%);
  border-radius: var(--radius--round);
  padding: var(--_spacing---space--3) var(--_spacing---space--8);
  margin-right: var(--_spacing---space--7);
  font-family: var(--_typography---font--primary-family);
  font-size: var(--_typography---font-size--h4);
  font-weight: 500;
  color: var(--swatch--light-100);
  text-decoration: none;
  white-space: nowrap;
}

/* meta row */
.footer-meta {
  display: flex;
  margin-top: var(--_spacing---section-space--main);
}

.footer-meta-left {
  flex: 1;
  display: flex;
  gap: var(--_spacing---space--8);
}

.footer-meta-right { flex: 1; }

.footer-meta-label {
  /* 25% white only reads ~3:1 against this dark footer bg — lightened further to ~5.5:1 */
  color: color-mix(in srgb, var(--swatch--accent-500), white 45%);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-family: var(--_typography---font--primary-family);
  font-size: var(--_typography---font-size--text-main);
  font-weight: 800;
  margin: 0 0 var(--_spacing---space--1);
}

.footer-meta-value {
  font-size: var(--_typography---font-size--h5);
  font-weight: 400;
  color: var(--swatch--light-100);
  margin: 0;
  letter-spacing: 0.03em;
}

.footer-socials { display: flex; gap: 0; }

.footer-social-link {
  font-size: var(--_typography---font-size--h5);
  font-weight: 400;
  color: var(--swatch--light-100);
  margin-right: var(--_spacing---space--5);
  text-decoration: none;
  letter-spacing: 0.03em;
}

/* Divider between meta-left and meta-right (hidden at desktop, shown at tablet) —
   no responsive-variable equivalent for a none-at-large/block-at-medium toggle, kept as @media */
.footer-meta-divider {
  display: none;
  background-color: var(--swatch--accent-500);
  width: 100%;
  height: 3px;
}

/* Tablet — pill sizes auto-shrink from global font-size:14px */
@media screen and (max-width: 991px) {
  .footer-container { padding-bottom: 0; }
  .footer-meta-divider { display: block; }
  .footer-meta { flex-wrap: wrap; }
  .footer-meta-left { width: 100%; }
  .footer-meta-right { width: 100%; }
}

/* Mobile */
@media screen and (max-width: 767px) {
  .footer-pills { flex-direction: var(--column-small, row); gap: var(--_spacing---space--3); align-items: flex-start; }
  .footer-pill  { white-space: normal; }
  .footer-meta  { flex-direction: var(--column-small, row); gap: var(--_spacing---space--5); margin-bottom: var(--_spacing---space--8); }
  .footer-meta-left { flex-direction: var(--column-small, row); gap: var(--_spacing---space--4); }
  .footer-arrow { font-size: 2em; }
}

/* Small mobile */
@media screen and (max-width: 479px) {
  .footer-pill  { font-size: var(--_typography---font-size--h5); padding-left: var(--_spacing---space--3); padding-right: var(--_spacing---space--3); }
}
</style>
