---
const projects = [
  {
    title: 'The Butterfly CFI',
    src: '/assets/images/69d55440de29525bb5ec52a8_the_butterfly_cfi_logo_mock_up.jpg',
    tag: 'Branding & Identity',
  },
  {
    title: 'Spencer Grey Art',
    src: '/assets/images/69d555693be7d4ffefb2a937_spencer_grey_website_on_pixel_jones_portfolio_site.jpg',
    tag: 'Web Design & Dev',
  },
  {
    title: 'DSC Family Reunion',
    src: '/assets/images/69d55e6c12ad0b79a8a3f9ae_dsc_family_reunion_pixel_jones.jpg',
    tag: 'Web Design',
  },
  {
    title: 'Tremulant',
    src: '/assets/images/69d55fe73960cc20e9554315_tremulant_poster_pixel_jones.jpg',
    tag: 'Print & Poster Design',
  },
];
---

<section id="work" class="work-sec">
  <img
    src="/assets/images/62f6c3cffd7b99342f2f8896_right-art.avif"
    alt=""
    class="work-art-left"
    aria-hidden="true"
  />

  <div class="work-container">
    <div class="work-watermark" aria-hidden="true">
      <span class="work-watermark-text">MY WORK MY WORK MY WORK</span>
    </div>

    <p class="work-recent-label">Recent Work</p>
    <div class="nav-divider work-divider"></div>

    <div class="splide work-splide">
      <div class="splide__track">
        <ul class="splide__list">
          {projects.map(proj => (
            <li class="splide__slide work-card">
              <img src={proj.src} alt={proj.title} class="work-card-img" loading="lazy" />
              <div class="work-card-overlay"></div>
              <p class="work-card-tag">{proj.tag}</p>
              <h5 class="work-card-title">{proj.title}</h5>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
.work-sec {
  background-color: var(--background-blue);
  padding: 5em 0 11.1em;
  overflow: hidden;
  position: relative;
}

.work-art-left {
  position: absolute;
  top: 43%;
  left: 0;
  height: 31.7em;
  z-index: 0;
  pointer-events: none;
}

.work-container {
  max-width: 100em;
  margin: 0 auto;
  padding: 0 6em;
  position: relative;
  z-index: 1;
}

.work-watermark {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}
.work-watermark-text {
  font-family: 'Mortend Outline', sans-serif;
  font-weight: 800;
  font-size: 11em;
  color: var(--font-light);
  opacity: 0.04;
  white-space: nowrap;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  display: block;
}

.work-recent-label {
  opacity: 0.37;
  text-transform: uppercase;
  font-size: 1.1em;
  font-weight: 700;
  font-family: Poppins, sans-serif;
  color: var(--font-light);
  margin: 4.13em 0 1em;
  position: relative;
  z-index: 1;
}

.work-divider {
  position: relative;
  z-index: 1;
  margin-bottom: 2em;
}

/* Splide carousel — full width */
.work-splide {
  overflow: visible;
  position: relative;
  z-index: 1;
}
.work-splide .splide__track { overflow: visible; padding-bottom: 4em; }

.work-card {
  height: 42rem;
  position: relative;
  border-radius: 1rem;
  overflow: hidden;
}

.work-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.work-card-overlay {
  position: absolute;
  inset: 0;
  background-image: linear-gradient(5deg, #2a0946eb, rgba(255,255,255,0) 60%);
}

.work-card-tag {
  position: absolute;
  inset: auto 0% 14% 4%;
  font-family: Poppins, sans-serif;
  font-size: 0.85em;
  font-weight: 400;
  color: var(--font-light);
  opacity: 0.7;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin: 0;
}

.work-card-title {
  font-family: Mortend, sans-serif;
  font-weight: 800;
  font-size: clamp(18px, 1.8vw, 28px);
  line-height: 1;
  position: absolute;
  inset: auto 0% 7% 4%;
  color: var(--font-light);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin: 0;
}

/* Splide arrows — bottom-left of track */
.work-splide .splide__arrow {
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.25);
  width: 2.8em;
  height: 2.8em;
  border-radius: 50%;
  top: auto;
  bottom: 0.5em;
  transform: none;
  opacity: 1;
}
.work-splide .splide__arrow--prev { left: 0; }
.work-splide .splide__arrow--next { left: 3.5em; }
.work-splide .splide__arrow svg { fill: var(--font-light); width: 1em; height: 1em; }
.work-splide .splide__arrow:disabled { opacity: 0.3; }

/* Tablet */
@media screen and (max-width: 991px) {
  .work-container { padding: 0 3vw; }
  .work-art-left { height: 23.5em; top: 89%; }
  .work-card { height: 32rem; }
}

/* Mobile */
@media screen and (max-width: 767px) {
  .work-sec { padding: 2em 0 5em; }
  .work-container { padding: 0 5vw; }
  .work-art-left { height: 23.5em; top: 94%; }
  .work-watermark-text { font-size: 5em; }
  .work-splide { overflow: hidden !important; }
  .work-splide .splide__track { overflow: hidden !important; }
  .work-card { height: 26rem; }
}

/* Small mobile */
@media screen and (max-width: 479px) {
  .work-art-left { height: 13.6em; left: -7%; }
  .work-card { height: 22rem; }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const el = document.querySelector('.work-splide');
    if (!el || typeof Splide === 'undefined') return;
    new Splide(el, {
      type: 'loop',
      perMove: 1,
      perPage: 3,
      focus: 0,
      gap: '1.5em',
      arrows: true,
      pagination: false,
      speed: 600,
      updateOnMove: true,
      breakpoints: {
        991: { perPage: 2, gap: '1em' },
        767: { perPage: 1, gap: '1em' },
        479: { perPage: 1, gap: '1em' },
      },
    }).mount();
  });
</script>
