---
// Portfolio carousel — 2 cards wide (Splide.js style, static render)
const projects = [
  {
    title: 'The Butterfly CFI',
    src: '/assets/images/69d55440de29525bb5ec52a8_the_butterfly_cfi_logo_mock_up.jpg',
    tag: 'Branding & Identity',
  },
  {
    title: 'Spencer Grey Art',
    src: '/assets/images/69d555693be7d4ffefb2a937_spencer_grey_website_on_pixel_jones_portfolio_site.jpg',
    tag: 'Web Design & Dev',
  },
  {
    title: 'DSC Family Reunion',
    src: '/assets/images/69d55e6c12ad0b79a8a3f9ae_dsc_family_reunion_pixel_jones.jpg',
    tag: 'Web Design',
  },
  {
    title: 'Tremulant',
    src: '/assets/images/69d55fe73960cc20e9554315_tremulant_poster_pixel_jones.jpg',
    tag: 'Print & Poster Design',
  },
];

// Work list (vertical) — shown alongside the carousel
const listItems = [
  { thumb: '/assets/images/672319b9b8617a6a9afb4534_Screenshot_2024-10-30_224619.avif', title: 'Zoo Tube', tag: 'design & development' },
  { thumb: '/assets/images/61d38d6eaedc7a746c70281a_The_breakfast_club_poster_mockup_11x17_15ONE.avif', title: 'TBC', tag: 'design & development' },
  { thumb: '/assets/images/61d38d75eac6788290cc902e_the-breakfast-club_poster_mockup.avif', title: 'TBC Alt', tag: 'poster design' },
  { thumb: '/assets/images/62e5a05a9afb7e144c871ffa_crystal_method_poster_webonly.avif', title: 'Crystal Method', tag: 'poster design' },
];
---

<section id="work" style="background-color:var(--background-blue);padding:5em 0;">
  <div style="max-width:100em;margin:0 auto;padding:0 6em;position:relative;">

    <!-- watermark -->
    <div style="position:absolute;top:0;left:0;right:0;overflow:hidden;pointer-events:none;z-index:0;">
      <span style="font-family:'Mortend Outline',sans-serif;font-weight:800;font-size:11em;color:var(--font-light);opacity:0.04;white-space:nowrap;text-transform:uppercase;letter-spacing:-0.02em;display:block;">MY WORK MY WORK MY WORK</span>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;position:relative;z-index:1;">
      <!-- left: work list -->
      <div>
        <div style="margin-top:4.13em;padding-bottom:0;">
          <p style="opacity:0.37;text-transform:uppercase;padding-left:2em;font-size:1.1em;font-weight:700;font-family:Poppins,sans-serif;color:var(--font-light);margin-bottom:1em;">Recent Work</p>
          <div class="nav-divider" style="margin-bottom:0;"></div>

          {listItems.map(item => (
            <div>
              <div style="display:flex;flex-direction:row-reverse;justify-content:space-between;align-items:center;width:100%;padding-bottom:2.2rem;margin-top:2.2rem;">
                <!-- image -->
                <div style="padding-right:0.2rem;">
                  <img src={item.thumb} alt={item.title} style="width:9vw;aspect-ratio:1;object-fit:cover;border-radius:1rem;" loading="lazy" />
                </div>
                <!-- title -->
                <div style="display:flex;flex-direction:column;justify-content:center;align-items:flex-start;">
                  <div style="position:relative;padding-right:2rem;">
                    <h2 style="font-family:Mortend,sans-serif;font-weight:800;font-size:4.6em;line-height:1;color:var(--font-light);margin:0;text-transform:uppercase;">{item.title}</h2>
                  </div>
                  <p style="font-family:Poppins,sans-serif;font-size:0.9em;color:var(--font-light);opacity:0.6;margin:0;">{item.tag}</p>
                </div>
              </div>
              <div class="nav-divider"></div>
            </div>
          ))}
        </div>
      </div>

      <!-- right: portfolio cards — horizontal scroll carousel, clips left edge only -->
      <div style="clip-path:inset(-4rem -100vw -4rem 0);padding:4em 0 0 3em;">
        <div class="work-carousel">
          {projects.map(proj => (
            <div style="flex:none;width:31vw;height:32.7rem;position:relative;border-radius:1rem;overflow:hidden;scroll-snap-align:start;">
              <img src={proj.src} alt={proj.title} style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
              <div style="position:absolute;inset:0 0 0;background-image:linear-gradient(5deg,#2a0946eb,rgba(255,255,255,0) 99%);height:100%;"></div>
              <h5 style="
                font-size:clamp(22px,2vw,32px);
                line-height:0.95;
                position:absolute;
                inset:auto 0% 7% 4%;
                font-family:Mortend,sans-serif;
                font-weight:800;
                color:var(--font-light);
                text-transform:uppercase;
                letter-spacing:0.04em;
                margin:0;
              ">{proj.title}</h5>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
