---
const projects = [
  {
    title: 'The Butterfly CFI',
    src: '/assets/images/69d55440de29525bb5ec52a8_the_butterfly_cfi_logo_mock_up.jpg',
    tag: 'Branding & Identity',
    slug: 'butterfly-cfi',
  },
  {
    title: 'Spencer Grey Art',
    src: '/assets/images/69d555693be7d4ffefb2a937_spencer_grey_website_on_pixel_jones_portfolio_site.jpg',
    tag: 'Web Design & Dev',
    slug: 'spencer-grey-art',
  },
  {
    title: 'DSC Family Reunion',
    src: '/assets/images/69d55e6c12ad0b79a8a3f9ae_dsc_family_reunion_pixel_jones.jpg',
    tag: 'Web Design',
    slug: 'dsc-family-reunion',
  },
  {
    title: 'Tremulant',
    src: '/assets/images/69d55fe73960cc20e9554315_tremulant_poster_pixel_jones.jpg',
    tag: 'Print & Poster Design',
    slug: 'tremulant',
  },
  {
    title: 'Shameless Productions',
    src: '/assets/images/6881dc72a12b39532697f0cd_Screenshot_2025-07-24_000936.avif',
    tag: 'Web Design & Dev',
    slug: 'shameless-productions',
  },
  {
    title: 'Kobase Landing Page',
    src: '/assets/images/6881dcfee52d43ae2ba5a170_Screenshot_2025-07-24_001242.avif',
    tag: 'Web Design',
    slug: 'kobase',
  },
  {
    title: 'House Cleaning Records',
    src: '/assets/images/6881dd39f62b061a6e246c06_Screenshot_2025-07-24_001343.avif',
    tag: 'Web Design & Dev',
    slug: 'house-cleaning-records',
  },
];
---

<section id="work" class="work-sec">
  <div class="work-container">
    <h1 class="work-watermark-text" aria-hidden="true">my work my work my work</h1>

    <p class="work-recent-label">Recent Work</p>
    <div class="nav-divider work-divider"></div>

    <div class="splide work-splide">
      <div class="splide__track">
        <ul class="splide__list">
          {projects.map(proj => (
            <li class="splide__slide work-card" data-trigger="hover">
              <a href={`/work/${proj.slug}`} class="work-card-link">
                <img src={proj.src} alt={proj.title} class="work-card-img" loading="lazy" />
                <div class="work-card-blur"></div>
                <div class="work-card-overlay"></div>
                <div class="work-card-info">
                  <p class="work-card-tag">{proj.tag}</p>
                  <h5 class="work-card-title">{proj.title}</h5>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
.work-sec {
  background-color: var(--swatch--dark-900);
  padding-top: var(--_spacing---section-space--small);
  padding-bottom: var(--_spacing---section-space--large);
  overflow: clip;
  position: relative;
}


.work-container {
  max-width: var(--max-width--main);
  margin: 0 auto;
  padding-left: var(--site--margin);
  padding-right: var(--site--margin);
  position: relative;
  z-index: 1;
}

/* Full-bleed watermark — same technique and size as About's
   .about-outline-text: left:50% of a centered container always lands at
   50vw regardless of container width, so translateX(-50vw) walks it back
   to the true viewport edge on any screen size. Opacity is higher than
   About's (0.18) — that value reads fine on About's light background, but
   the same purple-on-dark-navy blend here was nearly invisible against
   this section's dark background, per request to make it more visible. */
.work-watermark-text {
  font-family: 'Mortend Outline', sans-serif;
  font-weight: 800;
  font-size: clamp(5rem, 4.1rem + 4.5vw, 7rem);
  color: var(--swatch--accent-500);
  opacity: 0.45;
  white-space: nowrap;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50vw);
  z-index: -1;
  pointer-events: none;
  text-transform: uppercase;
}

.work-recent-label {
  opacity: 0.37;
  text-transform: uppercase;
  font-family: var(--_typography---font--primary-family);
  font-size: var(--_typography---font-size--text-main);
  font-weight: 700;
  color: var(--swatch--light-100);
  margin-top: var(--_spacing---space--8);
  margin-bottom: var(--_spacing---space--3);
  position: relative;
  z-index: 1;
}

.work-divider {
  position: relative;
  z-index: 1;
  margin-bottom: var(--_spacing---space--5);
}

/* Splide carousel — full width */
.work-splide {
  overflow: visible;
  position: relative;
  z-index: 1;
  /* Hard-clip the starting left edge only, so the loop carousel's overflow
     (the previous/last slide peeking in before the user interacts) is fully
     hidden there — no blur/fade, an instant cutoff. Right side stays
     un-clipped (inset's right value pushed 100vw out) so slides still bleed
     past the container edge on that side as before. */
  clip-path: inset(0 -100vw 0 0);
}
.work-splide .splide__track { overflow: visible; }
/* hide Splide arrows entirely */
.work-splide .splide__arrows { display: none; }

.work-card {
  position: relative;
  border-radius: var(--radius--main);
  overflow: clip;
  cursor: pointer;
  /* Splide sets each slide's width via inline style from its perPage/gap
     math, which keeps growing on very wide screens even past
     --max-width--main's cap. max-width still overrides that (CSS always
     clamps width regardless of where it's declared), capping the card size
     on the largest screens — height follows via the locked aspect-ratio. */
  max-width: 24rem;
}

.work-card-link {
  display: block;
  position: relative;
  width: 100%;
  height: 100%;
  color: inherit;
  text-decoration: none;
}

.work-card-img {
  width: 100%;
  /* aspect-ratio instead of an independent height clamp — width already
     scales fluidly via Splide's perPage/padding math (a different curve at
     every breakpoint), so a height clamp with its own min/max drifted the
     card's shape in and out at different sizes instead of scaling with it.
     4/5 matches the previous desktop proportions (~478px/377px ≈ 1.27). */
  aspect-ratio: 4 / 5;
  object-fit: cover;
  display: block;
  border-radius: var(--radius--main);
  transition: transform 0.6s cubic-bezier(.544,.375,.25,1);
  transform: scale(calc(1 + 0.08 * var(--_trigger---on, 0))) rotate(calc(2deg * var(--_trigger---on, 0)));
}

/* Frosted-glass blur behind the bottom third of the card, under the title —
   blurs the image itself (not just a color wash) so the text stays legible
   over busy photos. */
.work-card-blur {
  position: absolute;
  inset: auto 0 0 0;
  height: 40%;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  /* Masking this element's own alpha (not the image) fades the blur's
     visibility from 0 at the top edge to fully on at the bottom, so it
     reads as a gradual ramp instead of a hard on/off line. */
  -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 100%);
  mask-image: linear-gradient(to bottom, transparent 0%, black 100%);
  pointer-events: none;
}

.work-card-overlay {
  position: absolute;
  inset: 0;
  background-image: linear-gradient(to top, #2A0946EB 0%, transparent 60%);
  border-radius: var(--radius--main);
  pointer-events: none;
}

.work-card-info {
  position: absolute;
  inset: auto 4% 6% 4%;
  display: flex;
  flex-direction: column;
  gap: var(--_spacing---space--1);
}

.work-card-tag {
  font-family: var(--_typography---font--primary-family);
  font-size: var(--_typography---font-size--text-small);
  font-weight: 400;
  color: var(--swatch--light-100);
  opacity: 0.7;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin: 0;
}

.work-card-title {
  font-family: var(--_typography---font--heading-family);
  font-weight: 800;
  font-size: var(--_typography---font-size--h5);
  line-height: 1.1;
  color: var(--swatch--light-100);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin: 0;
}

/* Mobile — carousel overflow only (watermark clamp already scales itself) */
@media screen and (max-width: 767px) {
  .work-splide { overflow: clip !important; }
  .work-splide .splide__track { overflow: clip !important; }
  /* Splide's padding:{right} option (peek amount) is relative to this
     element's own box, which normally stops at .work-container's right
     padding (site--margin) — short of the true screen edge, unlike the
     larger breakpoints where the overflowing card's content touches the
     edge with zero gap. Pulling this element's right edge out by that same
     margin makes the peek reach flush to the true edge too. */
  .work-splide { margin-right: calc(-1 * var(--site--margin)); }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const el = document.querySelector('.work-splide');
    if (!el || typeof Splide === 'undefined') return;
    new Splide(el, {
      type: 'slide',
      perMove: 1,
      perPage: 3,
      focus: 0,
      gap: '1.5em',
      arrows: false,
      pagination: false,
      speed: 600,
      updateOnMove: true,
      breakpoints: {
        991: { perPage: 2, gap: '1em' },
        // padding shrinks the active slide so the next one peeks in on the
        // right (~1/3 of a slide) — perPage:1 alone fills the full track
        // width with zero peek. Applied at both mobile breakpoints — a
        // width in the 479-767 range only picks up the 767 config, so it
        // needs its own padding too, not just the 479 one.
        767: { perPage: 1, gap: '1em', padding: { left: '0.5rem', right: '25%' } },
        479: { perPage: 1, gap: '1em', padding: { left: '0.5rem', right: '25%' } },
      },
    }).mount();
  });
</script>
