---
---
<section id="about" class="about-sec u-theme-light">
  <div class="about-container">
    <h1 class="about-outline-text">about me about me about me</h1>

    <!-- photo + text row -->
    <div class="about-split">

      <!-- left: photo -->
      <div class="about-left">
        <div class="about-photo-card">
          <img
            src="/assets/images/6881cb528375b87c1cf2b7e3_outline_tek_jones.avif"
            alt="Tek Jones"
            class="about-photo"
            loading="lazy"
          />
        </div>
      </div>

      <!-- right: text -->
      <div class="about-right">
        <div class="about-text-wrap">
          <h1 class="about-name-heading u-text-style-h3">hello, <br>my name is tek</h1>
          <p class="about-body u-text-style-main">
            Whether it's building a website, creating a mobile app, or designing a logo, I have the skills and vision to bring your ideas to life. With a strong focus on user experience and a dedication to staying up-to-date on the latest industry trends, I'm confident in my ability to bring value to any project.
          </p>
          <a href="https://linkedin.com/in/ryan-jones-54b39562" target="_blank" class="about-cv-btn" data-trigger="hover focus">jump to cv</a>
        </div>
      </div>
    </div>

    <!-- stats bar -->
    <div class="about-stats">
      {[
        { num: '12', suffix: '+', label: 'Years of design\nexperience' },
        { num: '3', suffix: '+', label: 'graduate from\ncode fellows' },
        { num: '5', suffix: 'k+', label: 'completed\nprojects' },
      ].map((stat, i) => (
        <>
          <div class="stat-item">
            <div class="stat-icon">
              <img src="/assets/images/61ccd624703169e41884b4cf_logo3.avif" alt="" class="stat-logo" loading="lazy" />
            </div>
            <div class="stat-text">
              <h5 class="stat-num">
                {stat.num}<span class="stat-suffix">{stat.suffix}</span>
              </h5>
              <p class="stat-label">{stat.label}</p>
            </div>
          </div>
          {i < 2 && <div class="stat-divider"></div>}
        </>
      ))}
    </div>

  </div>
</section>

<style>
.about-sec {
  /* Reference has this section on --font-light (light-100), distinct from
     u-theme-light's default light-200 background — Contact keeps the
     u-theme-light default, this section overrides it. */
  background-color: var(--swatch--light-100);
  padding-top: var(--_spacing---section-space--main);
  padding-bottom: var(--_spacing---section-space--large);
  position: relative;
}

.about-container {
  max-width: var(--max-width--main);
  margin: 0 auto;
  padding-left: var(--site--margin);
  padding-right: var(--site--margin);
  /* z-index:0 (not just position:relative) pins this as the stacking context
     for .about-outline-text's z-index:-1 — otherwise that negative z-index
     escapes past this element's own background and disappears behind the
     section entirely. */
  position: relative;
  z-index: 0;
}

/* photo + text row — uses responsive variable, no @media needed for direction */
.about-split {
  display: flex;
  flex-direction: var(--column-medium, row);
  justify-content: space-between;
  align-items: center;
  width: 100%;
  margin-top: var(--_spacing---space--3);
  position: relative;
}

.about-left {
  width: 50%;
  position: relative;
  z-index: 100;
}

/* watermark outline — sits behind the photo card and all other content in this
   section (was z-index:10, painting on TOP of the photo where they overlapped) */
.about-outline-text {
  font-family: 'Mortend Outline', sans-serif;
  font-weight: 800;
  /* Narrow clamp range (was 1.98rem-5rem, shrank a lot) — "barely shrinks" per
     request, stays close to full size even on small screens. Bumped up again
     per request (bigger, moved down). */
  font-size: clamp(5rem, 4.1rem + 4.5vw, 7rem);
  color: var(--swatch--accent-500);
  opacity: 0.18;
  white-space: nowrap;
  position: absolute;
  /* Sits in the space opened up by .about-photo-card's margin-top below — bottom
     edge lands just above the photo, roughly level with the bottom of the "Hello,"
     line in the neighboring column (both columns share the same top). */
  top: 0.1em;
  /* True full-bleed to the viewport edge, not just this max-width container's
     edge — left:50% of a centered container always lands at 50vw regardless
     of container width, so translateX(-50vw) walks it back to viewport x:0
     on any screen size, including ones wider than --max-width--main. */
  left: 50%;
  /* extra -0.65em bleeds it further left past the edge, so it's cropped
     mid-word (around the "O" in "ABOUT") instead of starting clean on the "A" */
  transform: translateX(calc(-50vw - 0.65em));
  z-index: -1;
  pointer-events: none;
  text-transform: uppercase;
}

.about-photo-card {
  background-color: var(--swatch--muted-500);
  border-radius: var(--radius--main);
  /* opens up room above the photo for the watermark to actually be visible in —
     it sits behind everything (z-index -1), so without this gap the opaque photo
     just covers it completely */
  margin-top: var(--_spacing---space--8);
  display: flex;
  justify-content: center;
  align-items: stretch;
  height: auto;
  padding-right: var(--_spacing---space--8);
  position: relative;
}

.about-photo {
  /* fluid clamp, min 18rem @ 20rem viewport → max 30.8rem @ 90rem viewport */
  height: clamp(18rem, 14.34rem + 18.29vw, 30.8rem);
  flex: 0 auto;
  margin-top: -2.9em;
  transform: rotateY(180deg);
}

.about-right {
  width: 50%;
}

.about-text-wrap {
  padding-left: var(--site--margin);
  padding-right: var(--site--margin);
}

.about-name-heading {
  font-family: var(--_typography---font--heading-family);
  color: var(--swatch--heading-dark);
  text-transform: uppercase;
  margin-bottom: var(--_spacing---space--3);
  max-width: 12.8em;
}

.about-body {
  color: var(--_theme---text);
  margin-bottom: var(--_spacing---space--4);
  opacity: 0.55;
  /* No-op at desktop (the 50%-wide column is already narrower than this),
     but caps line length for readability once the layout stacks full-width
     at ≤991px — lines were running edge-to-edge otherwise. */
  max-width: 36em;
}

.about-cv-btn {
  display: inline-block;
  background-color: color-mix(in hsl, var(--swatch--accent-500) calc(100% * var(--_trigger---on)), color-mix(in srgb, var(--swatch--accent-500), black 20%) calc(100% * var(--_trigger---off)));
  color: var(--swatch--light-100);
  font-family: var(--_typography---font--heading-family);
  font-weight: 400;
  letter-spacing: var(--_typography---letter-spacing--tight);
  text-transform: uppercase;
  padding: var(--_spacing---space--3) var(--_spacing---space--5);
  border-radius: var(--radius--small);
  text-decoration: none;
}

/* stats bar */
.about-stats {
  /* --bg-stats (#c7bbd0) is the reference's dedicated card color — distinct
     from the section's own light-100 background it sits on top of. */
  background-color: var(--bg-stats);
  border-radius: var(--radius--main);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: var(--_spacing---section-space--small);
}

.stat-item {
  display: flex;
  justify-content: space-between;
  border-radius: var(--radius--small);
  overflow: clip;
}

.stat-icon {
  flex: 0 auto;
  justify-content: center;
  align-items: center;
  padding: var(--_spacing---space--3) var(--_spacing---space--4);
  display: flex;
}

.stat-logo {
  width: clamp(2rem, 3.5em, 4.5rem);
  height: clamp(2rem, 3.5em, 4.5rem);
  object-fit: contain;
}

.stat-text {
  flex: 0 auto;
  padding: var(--_spacing---space--4);
}

.stat-num {
  font-family: var(--_typography---font--heading-family);
  font-weight: 800;
  font-size: var(--_typography---font-size--h4);
  color: var(--_theme---text);
  opacity: 0.74;
  margin: 0;
  line-height: 1;
  text-transform: none;
}

.stat-suffix {
  font-size: 0.6em;
  /* Matches reference .achieve-headline-span (highlight-yellow). */
  color: var(--swatch--highlight-500);
}

.stat-label {
  font-family: var(--_typography---font--primary-family);
  font-size: var(--_typography---font-size--text-large);
  font-weight: 400;
  color: var(--_theme---text);
  opacity: 0.55;
  margin: 0;
  line-height: 1.3;
  white-space: pre-line;
}

.stat-divider {
  flex: 0 auto;
  background-color: var(--stat-divider-color);
  width: 4px;
  height: 10.1em;
  margin-left: var(--_spacing---space--6);
  margin-right: var(--_spacing---space--6);
  align-self: center;
}

/* --column-medium flips via the @container (width < 992px) rule in
   global.css — a *container*-width query on body's inline-size, not
   viewport width. A plain @media(max-width:991px) here would miss a dead
   zone: body's content-box is slightly narrower than the viewport
   (scrollbar), so the container query can already be active a few px
   before a viewport media query of the same nominal breakpoint fires.
   Using the identical @container condition keeps every fix below perfectly
   in sync with the actual layout switch. Watermark now fluid + behind
   everything, no longer needs hiding at this breakpoint. */
@container (width < 992px) {
  .about-left,
  .about-right   { width: 100%; }
  /* .about-split's align-items:center is for vertically centering the two
     columns in row layout — but once flex-direction flips to column here,
     "center" becomes the CROSS-axis (horizontal) alignment instead, which
     shrinks each column to content width and centers it rather than
     stretching it full-width. stretch restores full-width columns. */
  .about-split { align-items: stretch; }
  /* Header had zero gap from the photo above it in stacked layout (the row
     layout's vertical centering doesn't apply here). */
  .about-name-heading { padding-top: var(--_spacing---space--6); }
  /* about-text-wrap's left/right padding is the gutter between the photo
     and text columns in row layout — once stacked, it just indents the
     heading/paragraph/button relative to the photo and stats card below,
     which don't have that padding. Zero it so everything shares the same
     left edge. */
  .about-text-wrap { padding-left: 0; padding-right: 0; }
  /* Stack the 3 stat items instead of squeezing them into one cramped row
     — matches the photo/text column stacking at this same breakpoint. */
  .about-stats { flex-direction: column; align-items: stretch; }
  /* Divider was a vertical bar between row items (fixed width, horizontal
     margins) — stacked, it needs to be a horizontal rule between rows
     instead (full width, vertical margins). */
  .stat-divider {
    width: auto;
    height: 4px;
    align-self: stretch;
    margin-left: 0;
    margin-right: 0;
    margin-top: var(--_spacing---space--3);
    margin-bottom: var(--_spacing---space--3);
  }
}

/* Mobile — about-photo height now fluid */
@media screen and (max-width: 767px) {
  .about-photo-card { padding-right: var(--_spacing---space--5); }

  /* Stats are already stacked (vertical) since 991px — no more horizontal
     scroll needed, just a smaller icon on the tightest screens. */
  .stat-logo     { width: clamp(2rem, 10vw, 4rem); height: clamp(2rem, 10vw, 4rem); }
}

/* Small mobile */
@media screen and (max-width: 479px) {
  .stat-divider  { margin-top: var(--_spacing---space--2); margin-bottom: var(--_spacing---space--2); }
}
</style>
