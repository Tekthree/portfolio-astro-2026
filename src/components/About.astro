---
---
<section id="about" class="about-sec">
  <!-- decorative art — top-right of about section -->
  <img
    src="/assets/images/62f6c3e27640277a801c55cc_left-art.avif"
    alt=""
    class="about-art-right"
    aria-hidden="true"
  />

  <div class="about-container">

    <!-- blurb -->
    <div class="about-blurb-wrap">
      <h1 class="about-blurb-heading">
        My <em class="about-italic">mission</em> is to solve user challenges and convert them into loyal customers.
      </h1>
    </div>

    <!-- photo + text row -->
    <div class="about-split">

      <!-- left: photo -->
      <div class="about-left">
        <h1 class="about-outline-text">about me about me about me</h1>
        <div class="about-photo-card">
          <img
            src="/assets/images/6881cb528375b87c1cf2b7e3_outline_tek_jones.avif"
            alt="Tek Jones"
            class="about-photo"
            loading="lazy"
          />
        </div>
      </div>

      <!-- right: text -->
      <div class="about-right">
        <div class="about-text-wrap">
          <h1 class="about-name-heading">hello, <br>my name is tek</h1>
          <p class="about-body">
            Whether it's building a website, creating a mobile app, or designing a logo, I have the skills and vision to bring your ideas to life. With a strong focus on user experience and a dedication to staying up-to-date on the latest industry trends, I'm confident in my ability to bring value to any project.
          </p>
          <a href="https://linkedin.com/in/ryan-jones-54b39562" target="_blank" class="about-cv-btn">jump to cv</a>
        </div>
      </div>
    </div>

    <!-- stats bar -->
    <div class="about-stats">
      {[
        { num: '12', suffix: '+', label: 'Years of design\nexperience' },
        { num: '3', suffix: '+', label: 'graduate from\ncode fellows' },
        { num: '5', suffix: 'k+', label: 'completed\nprojects' },
      ].map((stat, i) => (
        <>
          <div class="stat-item">
            <div class="stat-icon">
              <img src="/assets/images/61ccd624703169e41884b4cf_logo3.avif" alt="" class="stat-logo" loading="lazy" />
            </div>
            <div class="stat-text">
              <h5 class="stat-num">
                {stat.num}<span class="stat-suffix">{stat.suffix}</span>
              </h5>
              <p class="stat-label">{stat.label}</p>
            </div>
          </div>
          {i < 2 && <div class="stat-divider"></div>}
        </>
      ))}
    </div>

  </div>
</section>

<style>
.about-sec {
  background-color: var(--font-light);
  padding: 7.7em 0 10.6em;
  position: relative;
}

/* Decorative art image — right side, matches Webflow image-5 */
.about-art-right {
  position: absolute;
  top: 9%;
  right: 0;
  height: 25.1em;
  opacity: 1;
  z-index: 1;
  pointer-events: none;
}

.about-container {
  max-width: 100em;
  margin: 0 auto;
  padding: 0 6em;
}

.about-blurb-wrap {
  margin-bottom: 10.2em;
  position: relative;
  max-width: 38em;
}

.about-blurb-heading {
  font-family: Mortend, sans-serif;
  font-weight: 800;
  font-size: clamp(1.5rem, 2.1vw + 1rem, 2.9rem);
  line-height: 1.2;
  color: var(--background-blue);
  text-transform: uppercase;
  opacity: 0.74;
  position: relative;
  z-index: 10;
}

.about-italic {
  font-style: italic;
  color: var(--submt-purple);
}

/* photo + text row — uses responsive variable, no @media needed for direction */
.about-split {
  display: flex;
  flex-direction: var(--column-medium, row);
  justify-content: space-between;
  align-items: flex-start;
  width: 100%;
  position: relative;
}

.about-left {
  width: 50%;
  position: relative;
  z-index: 100;
}

/* watermark outline */
.about-outline-text {
  font-family: 'Mortend Outline', sans-serif;
  font-weight: 800;
  font-size: 6.9em;
  color: var(--submt-purple);
  opacity: 0.18;
  white-space: nowrap;
  position: absolute;
  top: -0.69em;
  left: -63%;
  z-index: 10;
  pointer-events: none;
  text-transform: uppercase;
}

.about-photo-card {
  background-color: var(--font-plum);
  border-radius: 1rem;
  display: flex;
  justify-content: center;
  align-items: stretch;
  height: auto;
  padding-right: 3.91em;
  position: relative;
}

.about-photo {
  height: 30.8em;
  flex: 0 auto;
  margin-top: -2.9em;
  transform: rotateY(180deg);
}

.about-right {
  width: 50%;
}

.about-text-wrap {
  padding: 0 3.54em 4.74em;
}

.about-name-heading {
  font-family: Mortend, sans-serif;
  font-weight: 800;
  font-size: clamp(1.5rem, 2.1vw + 1rem, 2.9rem);
  line-height: 1;
  color: rgba(12,4,44,0.84);
  text-transform: uppercase;
  margin-bottom: 0.38em;
  max-width: 12.8em;
}

.about-body {
  font-family: Poppins, sans-serif;
  font-size: 1em;
  color: var(--background-blue);
  line-height: 1.6;
  margin-bottom: 1.3em;
  opacity: 0.85;
}

.about-cv-btn {
  display: inline-block;
  background-color: var(--submt-purple);
  color: var(--font-light);
  font-family: Mortend, sans-serif;
  font-weight: 400;
  font-size: 1.25em;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 0.9em 1.74em 0.67em;
  border-radius: 0.4em;
  text-decoration: none;
}

/* stats bar */
.about-stats {
  background-color: var(--bg-stats);
  border-radius: 1rem;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 5.73em;
}

.stat-item {
  display: flex;
  justify-content: space-between;
  border-radius: 0.5em;
  overflow: clip;
}

.stat-icon {
  flex: 0 auto;
  justify-content: center;
  align-items: center;
  padding: 0.94em 1.2em;
  display: flex;
}

.stat-logo {
  width: clamp(2rem, 3.5em, 4.5rem);
  height: clamp(2rem, 3.5em, 4.5rem);
  object-fit: contain;
}

.stat-text {
  flex: 0 auto;
  padding: 1.32em;
}

.stat-num {
  font-family: Mortend, sans-serif;
  font-weight: 800;
  font-size: clamp(2rem, 3vw + 0.5rem, 3.4rem);
  color: var(--background-blue);
  opacity: 0.74;
  margin: 0;
  line-height: 1;
  text-transform: none;
}

.stat-suffix {
  font-size: 0.6em;
  color: var(--highlight-yellow);
}

.stat-label {
  font-family: Poppins, sans-serif;
  font-size: 1.1em;
  font-weight: 400;
  color: var(--background-blue);
  margin: 0;
  line-height: 1.3;
  white-space: pre-line;
}

.stat-divider {
  flex: 0 auto;
  background-color: var(--stat-divider-color);
  width: 4px;
  height: 10.1em;
  margin-left: 2.76em;
  margin-right: 2.76em;
  align-self: center;
}

/* Tablet: flex-direction handled by --column-medium variable */
@media screen and (max-width: 991px) {
  .about-sec     { padding: 6.5em 0 8em; min-height: 0; }
  .about-container { padding: 0 6vw; }
  .about-blurb-wrap { margin-bottom: 4em; }
  .about-art-right { height: 20.8em; top: 3%; }

  .about-left,
  .about-right   { width: 100%; }
  .about-text-wrap { padding: 4.74em 0 4.74em; }
  .about-outline-text { display: none; }
}

/* Mobile */
@media screen and (max-width: 767px) {
  .about-sec     { padding: 3.3em 0 6em; min-height: 0; }
  .about-container { padding: 0 5vw; }
  .about-blurb-wrap { margin-bottom: 2.5em; }
  .about-art-right { height: 15.1em; top: 9%; }

  .about-photo   { height: 22em; }
  .about-photo-card { padding-right: 2em; }

  .about-text-wrap { padding: 3em 0 3em; }

  /* stats: allow horizontal scroll */
  .about-stats   { overflow-x: auto; justify-content: flex-start; padding: 0 1em; }
  .stat-logo     { width: clamp(2rem, 10vw, 4rem); height: clamp(2rem, 10vw, 4rem); }
}

/* Small mobile */
@media screen and (max-width: 479px) {
  .about-photo   { height: 18em; }
  .stat-divider  { margin-left: 1em; margin-right: 1em; }
  .about-art-right { display: none; }
}
</style>
