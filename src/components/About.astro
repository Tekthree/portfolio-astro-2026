---
---
<section id="about" class="about-sec u-theme-light">
  <div class="about-container">
    <h1 class="about-outline-text">about me about me about me</h1>

    <!-- photo + text row -->
    <div class="about-split">

      <!-- left: photo -->
      <div class="about-left">
        <div class="about-photo-card">
          <img
            src="/assets/images/6881cb528375b87c1cf2b7e3_outline_tek_jones.avif"
            alt="Ryan Jones"
            class="about-photo"
            loading="lazy"
          />
        </div>
      </div>

      <!-- right: text -->
      <div class="about-right">
        <div class="about-text-wrap">
          <h1 class="about-name-heading u-text-style-h3">hello, <br>my name is ryan</h1>
          <p class="about-body u-text-style-main">
            Most people know me by Tek. I design and build websites that look good and get found.
          </p>
          <p class="about-body u-text-style-main">
            Sites that show up when someone nearby searches for what you sell, and turn that traffic into phone calls.
          </p>
          <p class="about-body u-text-style-main">
            I also build AI systems that give your team back the hours they lose to busywork.
          </p>
          <a href="/ryan-jones-resume.pdf" target="_blank" rel="noopener" class="about-cv-btn" data-trigger="hover focus">my resume</a>
        </div>
      </div>
    </div>

    <!-- stats bar -->
    <div class="about-stats">
      {[
        { num: '15', suffix: '+', label: 'Years Crafting\nDigital Work', icon: '/assets/icons/screens.svg' },
        { num: '500', suffix: '+', label: 'Projects\nCompleted', icon: '/assets/icons/rockets.svg' },
        { num: '100', suffix: '%', label: 'Work Built\nIn-House', icon: '/assets/icons/dimonds.svg' },
      ].map((stat, i) => (
        <>
          <div class="stat-item">
            <div class="stat-icon">
              <img src={stat.icon} alt="" class="stat-logo" loading="lazy" />
            </div>
            <div class="stat-text">
              <h5 class="stat-num">
                {stat.num}<span class="stat-suffix">{stat.suffix}</span>
              </h5>
              <p class="stat-label">{stat.label}</p>
            </div>
          </div>
          {i < 2 && <div class="stat-divider"></div>}
        </>
      ))}
    </div>

  </div>
</section>

<style>
.about-sec {
  /* light-100 (#c0b3cb), darker than u-theme-light's light-200 default.
     This is the reference design and it is the base the --bg-stats card
     (#c7bbd0) was picked against, so the stats bar reads as a raised panel.
     Contact matches this deliberately, see .contact-sec. */
  background-color: var(--swatch--light-100);
  padding-top: var(--_spacing---section-space--main);
  padding-bottom: var(--_spacing---section-space--large);
  position: relative;
}

.about-container {
  max-width: var(--max-width--main);
  margin: 0 auto;
  padding-left: var(--site--margin);
  padding-right: var(--site--margin);
  /* z-index:0 (not just position:relative) pins this as the stacking context
     for .about-outline-text's z-index:-1 — otherwise that negative z-index
     escapes past this element's own background and disappears behind the
     section entirely. */
  position: relative;
  z-index: 0;
}

/* photo + text row — uses responsive variable, no @media needed for direction */
.about-split {
  display: flex;
  flex-direction: var(--column-medium, row);
  justify-content: space-between;
  align-items: center;
  width: 100%;
  margin-top: var(--_spacing---space--3);
  position: relative;
}

.about-left {
  width: 50%;
  position: relative;
  z-index: 100;
}

/* watermark outline — sits behind the photo card and all other content in this
   section (was z-index:10, painting on TOP of the photo where they overlapped) */
.about-outline-text {
  font-family: 'Mortend Outline', sans-serif;
  font-weight: 800;
  /* Narrow clamp range (was 1.98rem-5rem, shrank a lot) — "barely shrinks" per
     request, stays close to full size even on small screens. Bumped up again
     per request (bigger, moved down). */
  font-size: clamp(5rem, 4.1rem + 4.5vw, 7rem);
  color: var(--swatch--accent-500);
  opacity: 0.18;
  white-space: nowrap;
  position: absolute;
  /* Sits in the space opened up by .about-photo-card's margin-top below — bottom
     edge lands just above the photo, roughly level with the bottom of the "Hello,"
     line in the neighboring column (both columns share the same top). */
  top: 0.1em;
  /* True full-bleed to the viewport edge, not just this max-width container's
     edge — left:50% of a centered container always lands at 50vw regardless
     of container width, so translateX(-50vw) walks it back to viewport x:0
     on any screen size, including ones wider than --max-width--main. */
  left: 50%;
  /* extra -0.65em bleeds it further left past the edge, so it's cropped
     mid-word (around the "O" in "ABOUT") instead of starting clean on the "A" */
  transform: translateX(calc(-50vw - 0.65em));
  z-index: -1;
  pointer-events: none;
  text-transform: uppercase;
}

.about-photo-card {
  background-color: var(--swatch--muted-500);
  border-radius: var(--radius--main);
  /* opens up room above the photo for the watermark to actually be visible in —
     it sits behind everything (z-index -1), so without this gap the opaque photo
     just covers it completely */
  margin-top: var(--_spacing---space--8);
  display: flex;
  justify-content: center;
  align-items: stretch;
  height: auto;
  padding-right: var(--_spacing---space--8);
  position: relative;
}

.about-photo {
  /* fluid clamp, min 18rem @ 20rem viewport → max 30.8rem @ 90rem viewport */
  height: clamp(18rem, 14.34rem + 18.29vw, 30.8rem);
  flex: 0 auto;
  margin-top: -2.9em;
  transform: rotateY(180deg);
}

.about-right {
  width: 50%;
}

.about-text-wrap {
  padding-left: var(--site--margin);
  padding-right: var(--site--margin);
}

.about-name-heading {
  font-family: var(--_typography---font--heading-family);
  color: var(--swatch--heading-dark);
  text-transform: uppercase;
  margin-bottom: var(--_spacing---space--3);
  max-width: 12.8em;
}


.about-body {
  color: var(--_theme---text);
  /* Copy is three paragraphs now, not one. space--4 was authored as the gap
     down to the CV button; repeated between every paragraph it reads as a
     section break mid-thought. Tighter between paragraphs, full gap restored
     on the last one below. */
  margin-bottom: var(--_spacing---space--2);
  /* .7 matches .faq-answer, the only other body copy on this page. Was .55,
     which at the same font size read as smaller and weaker than the FAQ text
     rather than as the same paragraph style. */
  opacity: 0.7;
  /* No-op at desktop (the 50%-wide column is already narrower than this),
     but caps line length for readability once the layout stacks full-width
     at ≤991px — lines were running edge-to-edge otherwise. */
  max-width: 36em;
}

/* Restores the authored gap between the copy block and the CV button. */
.about-body:last-of-type {
  margin-bottom: var(--_spacing---space--4);
}


.about-cv-btn {
  display: inline-block;
  background-color: color-mix(in hsl, var(--swatch--accent-500) calc(100% * var(--_trigger---on)), color-mix(in srgb, var(--swatch--accent-500), black 20%) calc(100% * var(--_trigger---off)));
  color: var(--swatch--light-100);
  font-family: var(--_typography---font--heading-family);
  font-weight: 400;
  letter-spacing: var(--_typography---letter-spacing--tight);
  text-transform: uppercase;
  padding: var(--_spacing---space--3) var(--_spacing---space--5);
  border-radius: var(--radius--small);
  text-decoration: none;
}

/* stats bar */
.about-stats {
  /* --bg-stats (#c7bbd0) is the reference's dedicated card color — distinct
     from the section's own light-100 background it sits on top of. */
  background-color: var(--bg-stats);
  border-radius: var(--radius--main);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: var(--_spacing---section-space--small);
}

.stat-item {
  display: flex;
  justify-content: space-between;
  border-radius: var(--radius--small);
  overflow: clip;
}

.stat-icon {
  /* flex: none (not the default 0 auto) — the icon box must never shrink.
     .stat-icon and .stat-text both live in the same flex row (.stat-item);
     the label's longest unbreakable word sets a min-width .stat-text won't
     go below, so any row whose label happens to be longer pushed all the
     shrinkage onto this sibling instead, compressing .stat-logo's width
     (not height, since shrink only applies along the row's main axis) —
     which is why the 3 icons rendered at 3 different widths on narrow
     screens despite sharing identical width/height rules. */
  flex: none;
  justify-content: center;
  align-items: center;
  padding: var(--_spacing---space--3) var(--_spacing---space--4);
  display: flex;
}

.stat-logo {
  /* Fluid across the full viewport range, not a per-breakpoint jump — 2.75rem
     @ ~400px wide up to 6rem @ ~1600px wide, same authored pattern as
     .about-outline-text / .about-photo above. */
  width: clamp(2.75rem, 1.7rem + 4.3vw, 6rem);
  height: clamp(2.75rem, 1.7rem + 4.3vw, 6rem);
  object-fit: contain;
}

.stat-text {
  flex: 0 auto;
  padding: var(--_spacing---space--4);
}

.stat-num {
  font-family: var(--_typography---font--heading-family);
  font-weight: 800;
  font-size: var(--_typography---font-size--h4);
  color: var(--_theme---text);
  opacity: 0.74;
  margin: 0;
  line-height: 1;
  text-transform: none;
}

.stat-suffix {
  font-size: 1em;
  /* Matches reference .achieve-headline-span (highlight-yellow). */
  color: var(--swatch--highlight-500);
}

.stat-label {
  font-family: var(--_typography---font--primary-family);
  font-size: var(--_typography---font-size--text-large);
  font-weight: 400;
  color: var(--_theme---text);
  opacity: 0.55;
  margin: 0;
  line-height: 1.3;
  white-space: pre-line;
}

.stat-divider {
  flex: 0 auto;
  background-color: var(--stat-divider-color);
  width: 4px;
  height: 10.1em;
  margin-left: var(--_spacing---space--6);
  margin-right: var(--_spacing---space--6);
  align-self: center;
}

/* --column-medium flips via the @container (width < 992px) rule in
   global.css — a *container*-width query on body's inline-size, not
   viewport width. A plain @media(max-width:991px) here would miss a dead
   zone: body's content-box is slightly narrower than the viewport
   (scrollbar), so the container query can already be active a few px
   before a viewport media query of the same nominal breakpoint fires.
   Using the identical @container condition keeps every fix below perfectly
   in sync with the actual layout switch. Watermark now fluid + behind
   everything, no longer needs hiding at this breakpoint. */
@container (width < 992px) {
  .about-left,
  .about-right   { width: 100%; }
  /* .about-split's align-items:center is for vertically centering the two
     columns in row layout — but once flex-direction flips to column here,
     "center" becomes the CROSS-axis (horizontal) alignment instead, which
     shrinks each column to content width and centers it rather than
     stretching it full-width. stretch restores full-width columns. */
  .about-split { align-items: stretch; }
  /* Header had zero gap from the photo above it in stacked layout (the row
     layout's vertical centering doesn't apply here). */
  .about-name-heading { padding-top: var(--_spacing---space--6); }
  /* about-text-wrap's left/right padding is the gutter between the photo
     and text columns in row layout — once stacked, it just indents the
     heading/paragraph/button relative to the photo and stats card below,
     which don't have that padding. Zero it so everything shares the same
     left edge. */
  .about-text-wrap { padding-left: 0; padding-right: 0; }
  /* Stack the 3 stat items instead of squeezing them into one cramped row
     — matches the photo/text column stacking at this same breakpoint. */
  .about-stats { flex-direction: column; align-items: stretch; }
  /* Divider was a vertical bar between row items (fixed width, horizontal
     margins) — stacked, it needs to be a horizontal rule between rows
     instead (full width, vertical margins). */
  .stat-divider {
    width: auto;
    height: 4px;
    align-self: stretch;
    margin-left: 0;
    margin-right: 0;
    margin-top: var(--_spacing---space--3);
    margin-bottom: var(--_spacing---space--3);
  }
  /* Icon stays left, text block stays right — align-items:center vertically
     centers the icon against the text block's full height (not the group
     as a whole, which would drift the icon off the left edge). */
  .stat-item { justify-content: space-between; align-items: center; }
  /* Number sits beside the label instead of stacked above it — was two
     block-level children (h5 + p), so the number's own line took up its
     own row before the label even started. align-items:center (not
     baseline) keeps the number vertically centered against the label even
     when the label wraps to multiple lines. */
  .stat-text { display: flex; align-items: center; gap: var(--_spacing---space--3); }
  /* Room to breathe now that the row is centered and full-width — let the
     number grow to fill that space instead of staying pinned at the same
     size used in the cramped 3-across desktop row. */
  .stat-num { font-size: var(--_typography---font-size--h2); }

  /* Centers the outline watermark's own vertical midpoint directly over the
     photo card's top edge — only applies here because it's specifically a
     side-effect of the stacked (photo-above-text) layout this breakpoint
     creates; the row layout above 992px already reads fine as a full-width
     band and doesn't have this overlap. Measured live across the entire
     375-991px stacked range: the gap between the two was a consistent
     ~0.35em regardless of viewport width (both the text's clamp() and the
     card's spacing token scale together), so one fixed em offset from the
     base `top: 0.1em` holds across the whole range rather than needing a
     fluid clamp of its own. */
  .about-outline-text { top: -0.25em; }
}

/* Mobile — about-photo height now fluid */
@media screen and (max-width: 767px) {
  .about-photo-card { padding-right: var(--_spacing---space--5); }
  /* Bigger icons at this size — the fluid clamp() shrinks too far on narrow
     viewports, so pin a fixed floor here instead. */
  .stat-logo { width: 3.75rem; height: 3.75rem; }
}

/* Small mobile */
@media screen and (max-width: 479px) {
  .stat-divider  { margin-top: var(--_spacing---space--2); margin-bottom: var(--_spacing---space--2); }
  /* Number sits beside the label above 479px, but at this width the icon
     (now fixed-size, see .stat-icon) plus the number plus the label side by
     side left too little room for the label, forcing it into a cramped
     multi-line wrap. Stack the label under the number instead so it gets
     the full row width to itself. */
  .stat-text { flex-direction: column; align-items: flex-start; gap: 0; }
}
</style>
