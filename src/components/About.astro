---
---
<section id="about" class="about-sec u-theme-light">
  <!-- decorative art — top-right of about section -->
  <img
    src="/assets/images/62f6c3e27640277a801c55cc_left-art.avif"
    alt=""
    class="about-art-right"
    aria-hidden="true"
  />

  <div class="about-container">

    <!-- blurb -->
    <div class="about-blurb-wrap">
      <h1 class="about-blurb-heading u-text-style-h3">
        My <em class="about-italic">mission</em> is to solve user challenges and convert them into loyal customers.
      </h1>
    </div>

    <!-- photo + text row -->
    <div class="about-split">

      <!-- left: photo -->
      <div class="about-left">
        <h1 class="about-outline-text">about me about me about me</h1>
        <div class="about-photo-card">
          <img
            src="/assets/images/6881cb528375b87c1cf2b7e3_outline_tek_jones.avif"
            alt="Tek Jones"
            class="about-photo"
            loading="lazy"
          />
        </div>
      </div>

      <!-- right: text -->
      <div class="about-right">
        <div class="about-text-wrap">
          <h1 class="about-name-heading u-text-style-h3">hello, <br>my name is tek</h1>
          <p class="about-body u-text-style-main">
            Whether it's building a website, creating a mobile app, or designing a logo, I have the skills and vision to bring your ideas to life. With a strong focus on user experience and a dedication to staying up-to-date on the latest industry trends, I'm confident in my ability to bring value to any project.
          </p>
          <a href="https://linkedin.com/in/ryan-jones-54b39562" target="_blank" class="about-cv-btn" data-trigger="hover focus">jump to cv</a>
        </div>
      </div>
    </div>

    <!-- stats bar -->
    <div class="about-stats">
      {[
        { num: '12', suffix: '+', label: 'Years of design\nexperience' },
        { num: '3', suffix: '+', label: 'graduate from\ncode fellows' },
        { num: '5', suffix: 'k+', label: 'completed\nprojects' },
      ].map((stat, i) => (
        <>
          <div class="stat-item">
            <div class="stat-icon">
              <img src="/assets/images/61ccd624703169e41884b4cf_logo3.avif" alt="" class="stat-logo" loading="lazy" />
            </div>
            <div class="stat-text">
              <h5 class="stat-num">
                {stat.num}<span class="stat-suffix">{stat.suffix}</span>
              </h5>
              <p class="stat-label">{stat.label}</p>
            </div>
          </div>
          {i < 2 && <div class="stat-divider"></div>}
        </>
      ))}
    </div>

  </div>
</section>

<style>
.about-sec {
  padding-top: var(--_spacing---section-space--main);
  padding-bottom: var(--_spacing---section-space--large);
  position: relative;
}

/* Decorative art image — right side, matches Webflow image-5 */
.about-art-right {
  position: absolute;
  top: 9%;
  right: 0;
  /* fluid clamp, min 15.1rem @ 20rem viewport → max 25.1rem @ 90rem viewport */
  height: clamp(15.1rem, 12.24rem + 14.29vw, 25.1rem);
  opacity: 1;
  z-index: 1;
  pointer-events: none;
}

.about-container {
  max-width: var(--max-width--main);
  margin: 0 auto;
  padding-left: var(--site--margin);
  padding-right: var(--site--margin);
}

.about-blurb-wrap {
  margin-bottom: var(--_spacing---section-space--large);
  position: relative;
  max-width: 38em;
}

.about-blurb-heading {
  font-family: var(--_typography---font--heading-family);
  color: var(--_theme---text);
  opacity: 0.74;
  position: relative;
  z-index: 10;
}

.about-italic {
  font-style: italic;
  color: var(--swatch--accent-500);
}

/* photo + text row — uses responsive variable, no @media needed for direction */
.about-split {
  display: flex;
  flex-direction: var(--column-medium, row);
  justify-content: space-between;
  align-items: flex-start;
  width: 100%;
  position: relative;
}

.about-left {
  width: 50%;
  position: relative;
  z-index: 100;
}

/* watermark outline */
.about-outline-text {
  font-family: 'Mortend Outline', sans-serif;
  font-weight: 800;
  font-size: 6.9em;
  color: var(--swatch--accent-500);
  opacity: 0.18;
  white-space: nowrap;
  position: absolute;
  top: -0.69em;
  left: -63%;
  z-index: 10;
  pointer-events: none;
  text-transform: uppercase;
}

.about-photo-card {
  background-color: var(--swatch--muted-500);
  border-radius: var(--radius--main);
  display: flex;
  justify-content: center;
  align-items: stretch;
  height: auto;
  padding-right: var(--_spacing---space--8);
  position: relative;
}

.about-photo {
  /* fluid clamp, min 18rem @ 20rem viewport → max 30.8rem @ 90rem viewport */
  height: clamp(18rem, 14.34rem + 18.29vw, 30.8rem);
  flex: 0 auto;
  margin-top: -2.9em;
  transform: rotateY(180deg);
}

.about-right {
  width: 50%;
}

.about-text-wrap {
  padding-left: var(--site--margin);
  padding-right: var(--site--margin);
  padding-bottom: var(--_spacing---section-space--small);
}

.about-name-heading {
  font-family: var(--_typography---font--heading-family);
  color: var(--_theme---text);
  margin-bottom: var(--_text-style---h3-margin-bottom);
  max-width: 12.8em;
}

.about-body {
  color: var(--_theme---text);
  margin-bottom: var(--_spacing---space--4);
  opacity: 0.85;
}

.about-cv-btn {
  display: inline-block;
  background-color: color-mix(in hsl, var(--swatch--accent-500) calc(100% * var(--_trigger---on)), color-mix(in srgb, var(--swatch--accent-500), black 20%) calc(100% * var(--_trigger---off)));
  color: var(--swatch--light-100);
  font-family: var(--_typography---font--heading-family);
  font-weight: 400;
  letter-spacing: var(--_typography---letter-spacing--tight);
  text-transform: uppercase;
  padding: var(--_spacing---space--3) var(--_spacing---space--5);
  border-radius: var(--radius--small);
  text-decoration: none;
}

/* stats bar */
.about-stats {
  background-color: var(--_theme---background-2);
  border-radius: var(--radius--main);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: var(--_spacing---section-space--small);
}

.stat-item {
  display: flex;
  justify-content: space-between;
  border-radius: var(--radius--small);
  overflow: clip;
}

.stat-icon {
  flex: 0 auto;
  justify-content: center;
  align-items: center;
  padding: var(--_spacing---space--3) var(--_spacing---space--4);
  display: flex;
}

.stat-logo {
  width: clamp(2rem, 3.5em, 4.5rem);
  height: clamp(2rem, 3.5em, 4.5rem);
  object-fit: contain;
}

.stat-text {
  flex: 0 auto;
  padding: var(--_spacing---space--4);
}

.stat-num {
  font-family: var(--_typography---font--heading-family);
  font-weight: 800;
  font-size: var(--_typography---font-size--h4);
  color: var(--_theme---text);
  opacity: 0.74;
  margin: 0;
  line-height: 1;
  text-transform: none;
}

.stat-suffix {
  font-size: 0.6em;
  color: var(--swatch--highlight-500);
}

.stat-label {
  font-family: var(--_typography---font--primary-family);
  font-size: var(--_typography---font-size--text-large);
  font-weight: 400;
  color: var(--_theme---text);
  margin: 0;
  line-height: 1.3;
  white-space: pre-line;
}

.stat-divider {
  flex: 0 auto;
  background-color: color-mix(in srgb, var(--swatch--light-200), black 15%);
  width: 4px;
  height: 10.1em;
  margin-left: var(--_spacing---space--6);
  margin-right: var(--_spacing---space--6);
  align-self: center;
}

/* Tablet: flex-direction handled by --column-medium variable; width swap and
   watermark-hide have no responsive-variable equivalent, kept as @media */
@media screen and (max-width: 991px) {
  .about-left,
  .about-right   { width: 100%; }
  .about-outline-text { display: none; }
}

/* Mobile — about-photo height now fluid */
@media screen and (max-width: 767px) {
  .about-photo-card { padding-right: var(--_spacing---space--5); }

  /* stats: allow horizontal scroll */
  .about-stats   { overflow-x: auto; justify-content: flex-start; padding: 0 var(--_spacing---space--3); }
  .stat-logo     { width: clamp(2rem, 10vw, 4rem); height: clamp(2rem, 10vw, 4rem); }
}

/* Small mobile */
@media screen and (max-width: 479px) {
  .stat-divider  { margin-left: var(--_spacing---space--3); margin-right: var(--_spacing---space--3); }
  .about-art-right { display: none; }
}
</style>
