---
---
<section class="spline-sec">
  <div class="spline-mask">
    <spline-viewer
      url="https://prod.spline.design/HnX4nUFdAucbN4E1/scene.splinecode"
      class="spline-viewer"
    ></spline-viewer>
  </div>
</section>

<script type="module" src="https://unpkg.com/@splinetool/viewer@1.9.82/build/spline-viewer.js"></script>

<style>
.spline-sec {
  /* fade the section background into the footer's dark-800 so there's no hard seam */
  background: linear-gradient(180deg, var(--swatch--dark-900) 0%, var(--swatch--dark-900) 40%, var(--swatch--dark-800) 100%);
  /* fluid clamp, min 14rem @ 20rem viewport → max 54.2rem @ 90rem viewport */
  height: clamp(14rem, 2.51rem + 57.43vw, 54.2rem);
  position: relative;
  overflow: clip;
}

.spline-mask {
  position: absolute;
  inset: 0;
  overflow: clip;
  -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 72%, rgba(0,0,0,0) 100%);
  mask-image: linear-gradient(to bottom, #000 0%, #000 72%, rgba(0,0,0,0) 100%);
  -webkit-mask-size: 100% 100%;
  mask-size: 100% 100%;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
}

.spline-viewer {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: max(100%, 1600px);
  height: 100%;
  display: block;
}

</style>
