---
const faqs = [
  {
    q: 'What services do you offer?',
    a: 'Full stack web development, UI/UX design, branding and logo design, print design, and event flyer creation. I work across the full project lifecycle from concept to shipped.',
  },
  {
    q: 'How does your Air Force experience benefit projects?',
    a: 'Six years in logistics taught me how to manage competing priorities, hit hard deadlines, and communicate clearly across all levels. That discipline carries into how I run projects.',
  },
  {
    q: 'What do you do in your free time?',
    a: 'I DJ under the name Tek Jones at Shameless events around Seattle. I also build side projects, follow the AI space closely, and try to keep an N64 running.',
  },
];

const stream = [
  '/assets/images/67e3a3b69c71ee1001a7d6de_473055189_1232004684567859_4183718407854290834_n.jpeg',
  '/assets/images/67e3a545925e116abea32fcd_472974058_2035336776894147_3898270347369743547_n.avif',
  '/assets/images/67e3a545dd9fe0dad75cf621_466381292_1273748096998172_5187508347495176669_n.avif',
  '/assets/images/67e3b3cac4d8577789681cbd_473055189_1232004684567859_4183718407854290834_n.avif',
  '/assets/images/6881dc72a12b39532697f0cd_Screenshot_2025-07-24_000936.avif',
  '/assets/images/6881dcfee52d43ae2ba5a170_Screenshot_2025-07-24_001242.avif',
  '/assets/images/6881dd39f62b061a6e246c06_Screenshot_2025-07-24_001343.avif',
  '/assets/images/69d55440de29525bb5ec52a8_the_butterfly_cfi_logo_mock_up.jpg',
];
---

<section id="contact" class="contact-sec">
  <div class="contact-container">

    <!-- FAQ + photo row -->
    <div class="contact-split">
      <!-- left: FAQ -->
      <div class="contact-faq">
        <h1 class="contact-heading">got questions?<br>let's go!</h1>

        <div class="faq-list">
          {faqs.map(faq => (
            <details class="faq-item">
              <summary class="faq-summary">
                {faq.q}
                <span class="faq-arrow">⌄</span>
              </summary>
              <p class="faq-answer">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- right: photo -->
      <div class="contact-photo-wrap">
        <img
          src="/assets/images/65668aff757fdbce76749800_tek.avif"
          alt="Tek Jones"
          class="contact-photo"
          loading="lazy"
        />
      </div>
    </div>

    <!-- current work stream -->
    <div class="contact-stream">
      <div class="stream-grid">
        {stream.map(src => (
          <img src={src} alt="" class="stream-img" loading="lazy" />
        ))}
      </div>
      <div class="stream-footer">
        <p class="stream-label">Current Work Stream</p>
        <div class="stream-nav">
          <a href="#" class="stream-btn">&lt;</a>
          <a href="#" class="stream-btn">&gt;</a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
.contact-sec {
  background-color: #d9cfe0;
  padding: 7.7em 0 7.7em;
}

.contact-container {
  max-width: 100em;
  margin: 0 auto;
  padding: 0 6em;
}

/* FAQ + photo row — matches Webflow header1_component: 1fr 1fr grid, 5rem gap */
.contact-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 5rem;
  row-gap: 4rem;
  align-items: center;
}

.contact-faq { }

.contact-heading {
  font-family: Mortend, sans-serif;
  font-weight: 800;
  font-size: 2.9em;
  line-height: 1;
  color: rgba(12,4,44,0.84);
  text-transform: uppercase;
  margin-bottom: 0.38em;
  max-width: 12.8em;
}

.faq-list { }

.faq-item {
  border-top: 4px solid #9c8aaf;
}
.faq-item:last-child {
  border-bottom: 4px solid #9c8aaf;
}

.faq-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 0;
  cursor: pointer;
  list-style: none;
  font-family: Poppins, sans-serif;
  font-size: 1.125rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--background-blue);
  opacity: 0.74;
}

.faq-summary::-webkit-details-marker { display: none; }

.faq-arrow {
  font-size: 1.4em;
  margin-left: 1em;
  flex-shrink: 0;
}

.faq-answer {
  font-family: Poppins, sans-serif;
  font-size: 0.95em;
  color: var(--background-blue);
  opacity: 0.75;
  padding-bottom: 1.2em;
  line-height: 1.6;
  margin: 0;
}

/* right photo — stretch to fill the grid cell height set by the FAQ column */
.contact-photo-wrap {
  align-self: stretch;
  min-height: 20em;
}

.contact-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 1rem;
}

/* work stream */
.contact-stream { margin-top: 5em; }

.stream-grid {
  display: flex;
  gap: 0.8em;
  overflow-x: auto;
  padding-bottom: 0.5em;
  scrollbar-width: none;
}
.stream-grid::-webkit-scrollbar { display: none; }

.stream-img {
  flex: none;
  width: 10rem;
  height: 10rem;
  object-fit: cover;
  border-radius: 1rem;
}

.stream-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 2em;
}

.stream-label {
  font-family: Poppins, sans-serif;
  font-weight: 300;
  font-size: 1.6em;
  text-transform: uppercase;
  color: var(--font-plum);
  margin: 0;
  max-width: 17ch;
}

.stream-nav { display: flex; gap: 1rem; align-items: center; }

.stream-btn {
  background-color: var(--font-plum);
  border-radius: 8rem;
  padding: 0 57px;
  font-size: 2.2em;
  font-weight: 600;
  color: var(--background-blue);
  display: inline-block;
  line-height: 1.6;
  text-decoration: none;
}

/* Tablet: stack photo below FAQ */
@media screen and (max-width: 991px) {
  .contact-container { padding: 0 3vw; }
  .contact-split { grid-template-columns: 1fr; row-gap: 2.5em; }
  .contact-photo-wrap { align-self: auto; min-height: auto; }
  .contact-photo { height: auto; max-height: 30em; object-position: top; }
  .stream-img { width: 8rem; height: 8rem; }
}

/* Mobile */
@media screen and (max-width: 767px) {
  .contact-sec { padding: 4em 0 3em; }
  .contact-container { padding: 0 5vw; }
  .contact-heading { font-size: 2.9em; }
  .stream-img { width: 6.5rem; height: 6.5rem; }
  .stream-label { font-size: 1.2em; max-width: 14ch; }
  .stream-btn { padding: 0 30px; font-size: 1.8em; }
}

/* Small mobile */
@media screen and (max-width: 479px) {
  .contact-heading { font-size: 2.1em; }
  .stream-img { width: 5rem; height: 5rem; }
  .stream-label { font-size: 1em; }
  .stream-footer { flex-direction: column; align-items: flex-start; gap: 1em; }
}
</style>
