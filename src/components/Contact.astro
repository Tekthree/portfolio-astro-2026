---
const faqs = [
  {
    q: 'What services do you offer?',
    a: 'Full stack web development, UI/UX design, branding and logo design, print design, and event flyer creation. I work across the full project lifecycle from concept to shipped.',
  },
  {
    q: 'How does your Air Force experience benefit projects?',
    a: 'Six years in logistics taught me how to manage competing priorities, hit hard deadlines, and communicate clearly across all levels. That discipline carries into how I run projects.',
  },
  {
    q: 'What do you do in your free time?',
    a: 'I DJ under the name Tek Jones at Shameless events around Seattle. I also build side projects, follow the AI space closely, and try to keep an N64 running.',
  },
];

const stream = [
  '/assets/images/diffusion-martha-van-straaten-2025.jpg',
  '/assets/images/diffusion-presents-dec-27.jpg',
  '/assets/images/dy3-album-cover.jpg',
  '/assets/images/houspitality-jan-2026.jpg',
  '/assets/images/reflect-jan-2026.jpg',
  '/assets/images/shameless-retreat-2025.jpg',
  '/assets/images/67e3a3b69c71ee1001a7d6de_473055189_1232004684567859_4183718407854290834_n.jpeg',
  '/assets/images/67e3a545925e116abea32fcd_472974058_2035336776894147_3898270347369743547_n.avif',
  '/assets/images/67e3a545dd9fe0dad75cf621_466381292_1273748096998172_5167508347495176669_n.avif',
  '/assets/images/67e3a54711b544b3fdb3510f_465910105_1136837401784567_8486477678749733869_n.avif',
  '/assets/images/67e3a5487c1a59de8605d55c_465991674_1044013940815390_1418303423827527112_n.avif',
  '/assets/images/67e3a54814d44c9a2339f96d_465762240_462111149730411_5745237578481703419_n.avif',
  '/assets/images/67e3a549a329f3960ac77ac9_465930915_1204146437311360_7694286451735485311_n.avif',
  '/assets/images/67e3a54da329f3960ac77edc_451005028_1478686779442615_9145551699761065315_n.avif',
  '/assets/images/67e3a54ea329f3960ac77f5a_450596364_877749064396825_909167063742369713_n.avif',
  '/assets/images/67e3a5505ff0b844ad3b3bb5_449826003_1055893769546179_6882847468433935444_n.avif',
  '/assets/images/67e3a551a85e205ff975af56_449271927_510842361404787_5203661432586774905_n.avif',
  '/assets/images/67e3a5525ff0b844ad3b3d79_449325169_2292375900965777_8538668538527537064_n.avif',
  '/assets/images/67e3a55314d44c9a233a042e_448933607_793486612562726_2792252481503754229_n.avif',
  '/assets/images/67e3a55314d44c9a233a0487_449071694_1281087929521474_1568373398779667179_n.avif',
  '/assets/images/67e3a554cd7dac5efbff1b8a_448916634_838165021075093_4265239048265069128_n.avif',
  '/assets/images/67e3a55649f5339518c47694_449030288_1040096904136467_1219150151107769269_n.avif',
  '/assets/images/67e3a5578846ac61531ef2e6_448605994_1213177253376108_5485325501789568727_n.avif',
  '/assets/images/67e3a558e1c8dc14852e3828_448412999_1236281051114805_2885958496554144613_n.avif',
];
---

<section id="contact" class="contact-sec u-theme-light">
  <div class="contact-container">

    <!-- FAQ + photo row -->
    <div class="contact-split">
      <!-- left: FAQ -->
      <div class="contact-faq">
        <h1 class="contact-heading u-text-style-h3">got questions?<br>let's go!</h1>

        <div class="faq-list">
          {faqs.map(faq => (
            <details class="faq-item">
              <summary class="faq-summary">
                {faq.q}
                <span class="faq-arrow">⌄</span>
              </summary>
              <p class="faq-answer">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- right: photo -->
      <div class="contact-photo-wrap">
        <img
          src="/assets/images/65668aff757fdbce76749800_tek.avif"
          alt="Tek Jones"
          class="contact-photo"
          loading="lazy"
        />
      </div>
    </div>

    <!-- current work stream — Splide slider2, free drag, custom nav -->
    <div class="contact-stream">
      <div class="splide stream-splide">
        <div class="splide__track">
          <ul class="splide__list">
            {stream.map(src => (
              <li class="splide__slide stream-slide">
                <img src={src} alt="" class="stream-img" loading="lazy" />
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="stream-footer">
        <p class="stream-label">Current Work Stream</p>
        <div class="stream-nav">
          <button class="stream-btn stream-btn-prev" aria-label="Previous">&lt;</button>
          <button class="stream-btn stream-btn-next" aria-label="Next">&gt;</button>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
.contact-sec {
  padding-top: var(--_spacing---section-space--main);
  padding-bottom: var(--_spacing---section-space--main);
}

.contact-container {
  max-width: var(--max-width--main);
  margin: 0 auto;
  padding-left: var(--site--margin);
  padding-right: var(--site--margin);
}

/* FAQ + photo row — 2-col on desktop, 1-col on tablet/mobile */
.contact-split {
  display: var(--flex-medium, grid);
  flex-direction: column;
  grid-template-columns: 1fr 1fr;
  column-gap: var(--_spacing---section-space--small);
  row-gap: var(--_spacing---space--8);
  align-items: center;
}

.contact-faq { }

.contact-heading {
  font-family: var(--_typography---font--heading-family);
  color: var(--_theme---text);
  margin-bottom: var(--_text-style---h3-margin-bottom);
  max-width: 12.8em;
}

.faq-list { }

.faq-item {
  border-top: 4px solid color-mix(in srgb, var(--swatch--light-200), black 25%);
}
.faq-item:last-child {
  border-bottom: 4px solid color-mix(in srgb, var(--swatch--light-200), black 25%);
}

.faq-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--_spacing---space--3) 0;
  cursor: pointer;
  list-style: none;
  font-family: var(--_typography---font--primary-family);
  font-size: var(--_typography---font-size--text-main);
  font-weight: 700;
  text-transform: uppercase;
  color: var(--_theme---text);
  opacity: 0.74;
}

.faq-summary::-webkit-details-marker { display: none; }

.faq-arrow {
  font-size: 1.4em;
  margin-left: var(--_spacing---space--3);
  flex-shrink: 0;
}

.faq-answer {
  font-family: var(--_typography---font--primary-family);
  font-size: var(--_typography---font-size--text-small);
  color: var(--_theme---text);
  opacity: 0.75;
  padding-bottom: var(--_spacing---space--3);
  line-height: 1.6;
  margin: 0;
}

/* right photo — stretch to fill the grid cell height set by the FAQ column */
.contact-photo-wrap {
  align-self: stretch;
  min-height: 20em;
}

.contact-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: var(--radius--main);
}

/* FAQ arrow rotation */
.faq-arrow {
  transition: transform 0.3s ease;
  display: inline-block;
}
details[open] .faq-arrow { transform: rotate(180deg); }

/* work stream */
.contact-stream { margin-top: var(--_spacing---section-space--small); }

.stream-splide { overflow: visible; }
.stream-splide .splide__track { overflow: visible; }

.stream-slide {
  width: auto;
}

.stream-img {
  width: 10rem;
  height: 10rem;
  object-fit: cover;
  border-radius: var(--radius--main);
  display: block;
}

.stream-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--_spacing---space--5);
}

.stream-label {
  font-family: var(--_typography---font--primary-family);
  font-weight: 300;
  font-size: var(--_typography---font-size--h5);
  text-transform: uppercase;
  color: var(--swatch--muted-500);
  margin: 0;
  max-width: 17ch;
}

.stream-nav { display: flex; gap: var(--_spacing---space--3); align-items: center; }

.stream-btn {
  background-color: var(--swatch--muted-500);
  border: none;
  border-radius: var(--radius--round);
  padding: var(--_spacing---space--3) var(--_spacing---space--8);
  font-size: var(--_typography---font-size--h4);
  font-weight: 600;
  color: var(--_theme---text);
  display: inline-block;
  line-height: 1.6;
  cursor: pointer;
  font-family: var(--_typography---font--primary-family);
}

/* Tablet: display switch handled by --flex-medium variable */
@media screen and (max-width: 991px) {
  .contact-photo-wrap { align-self: auto; min-height: auto; }
  .contact-photo { height: auto; max-height: 30em; object-position: top; }
  .stream-img { width: 8rem; height: 8rem; }
}

/* Mobile */
@media screen and (max-width: 767px) {
  .contact-photo { max-height: 20em; }
  .stream-img { width: 6.5rem; height: 6.5rem; }
  .stream-label { max-width: 14ch; }
}

/* Small mobile */
@media screen and (max-width: 479px) {
  .stream-img { width: 5rem; height: 5rem; }
  .stream-footer { flex-direction: var(--column-xsmall, row); align-items: flex-start; gap: var(--_spacing---space--4); }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const el = document.querySelector('.stream-splide');
    if (!el || typeof Splide === 'undefined') return;

    const splide = new Splide(el, {
      type: 'slide',
      perPage: 1,
      perMove: 1,
      focus: 0,
      gap: '1em',
      arrows: false,
      pagination: false,
      drag: 'free',
      snap: false,
      autoWidth: true,
      trimSpace: false,
      updateOnMove: true,
      breakpoints: {
        991: { gap: '1em' },
        767: { gap: '0.75em' },
        479: { gap: '0.5em' },
      },
    }).mount();

    document.querySelector('.stream-btn-prev')?.addEventListener('click', () => splide.go('<'));
    document.querySelector('.stream-btn-next')?.addEventListener('click', () => splide.go('>'));
  });
</script>
