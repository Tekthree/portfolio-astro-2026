---
const faqs = [
  {
    q: 'What services do you offer?',
    a: 'Full stack web development, UI/UX design, branding and logo design, print design, and event flyer creation. I work across the full project lifecycle from concept to shipped.',
  },
  {
    q: 'How does your Air Force experience benefit projects?',
    a: 'Six years in logistics taught me how to manage competing priorities, hit hard deadlines, and communicate clearly across all levels. That discipline carries into how I run projects.',
  },
  {
    q: 'What do you do in your free time?',
    a: 'I DJ under the name Tek Jones at Shameless events around Seattle. I also build side projects, follow the AI space closely, and try to keep an N64 running.',
  },
];

// current work stream thumbnails
const stream = [
  '/assets/images/67e3a3b69c71ee1001a7d6de_473055189_1232004684567859_4183718407854290834_n.jpeg',
  '/assets/images/67e3a545925e116abea32fcd_472974058_2035336776894147_3898270347369743547_n.avif',
  '/assets/images/67e3a545dd9fe0dad75cf621_466381292_1273748096998172_5187508347495176669_n.avif',
  '/assets/images/67e3b3cac4d8577789681cbd_473055189_1232004684567859_4183718407854290834_n.avif',
  '/assets/images/6881dc72a12b39532697f0cd_Screenshot_2025-07-24_000936.avif',
  '/assets/images/6881dcfee52d43ae2ba5a170_Screenshot_2025-07-24_001242.avif',
  '/assets/images/6881dd39f62b061a6e246c06_Screenshot_2025-07-24_001343.avif',
  '/assets/images/69d55440de29525bb5ec52a8_the_butterfly_cfi_logo_mock_up.jpg',
];

---

<section id="contact" style="background-color:#d9cfe0;padding:7em 0 5em;">
  <div style="max-width:100em;margin:0 auto;padding:0 6em;">

    <!-- FAQ + photo -->
    <div style="display:flex;flex-direction:row;justify-content:space-between;align-items:flex-start;gap:4em;">
      <!-- left: FAQ -->
      <div style="flex:1;">
        <h1 style="font-family:Mortend,sans-serif;font-weight:800;font-size:2.9em;line-height:1;color:rgba(12,4,44,0.84);text-transform:uppercase;margin-bottom:1.5rem;max-width:12.8em;">
          got questions?<br>let's go!
        </h1>

        <div>
          {faqs.map(faq => (
            <details style="border-bottom:4px solid #9c8aaf;">
              <summary style="
                display:flex;
                justify-content:space-between;
                align-items:center;
                padding:1rem 0;
                cursor:pointer;
                list-style:none;
                font-family:Poppins,sans-serif;
                font-size:1.125rem;
                font-weight:700;
                text-transform:uppercase;
                color:var(--background-blue);
                opacity:0.74;
              ">
                {faq.q}
                <span style="font-size:1.4em;margin-left:1em;">⌄</span>
              </summary>
              <p style="font-family:Poppins,sans-serif;font-size:0.95em;color:var(--background-blue);opacity:0.75;padding-bottom:1.2em;line-height:1.6;margin:0;">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- right: photo -->
      <div style="flex:0 0 auto;width:38%;">
        <img
          src="/assets/images/65668aff757fdbce76749800_tek.avif"
          alt="Tek Jones"
          style="width:100%;border-radius:1rem;object-fit:cover;"
          loading="lazy"
        />
      </div>
    </div>

    <!-- current work stream -->
    <div style="margin-top:5em;">
      <div style="display:flex;gap:0.8em;overflow-x:auto;padding-bottom:0.5em;">
        {stream.map(src => (
          <img src={src} alt="" style="flex:none;width:10rem;height:10rem;object-fit:cover;border-radius:1rem;" loading="lazy" />
        ))}
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:2em;">
        <p style="font-family:Poppins,sans-serif;font-weight:300;font-size:1.6em;text-transform:uppercase;color:var(--font-plum);margin:0;max-width:17ch;">Current Work Stream</p>
        <div style="display:flex;gap:1rem;align-items:center;">
          <a href="#" style="background-color:var(--font-plum);border-radius:8rem;padding:0 57px;font-size:2.2em;font-weight:600;color:var(--background-blue);display:inline-block;line-height:1.6;text-decoration:none;">&lt;</a>
          <a href="#" style="background-color:var(--font-plum);border-radius:8rem;padding:0 57px;font-size:2.2em;font-weight:600;color:var(--background-blue);display:inline-block;line-height:1.6;text-decoration:none;">&gt;</a>
        </div>
      </div>
    </div>

  </div>

</section>
