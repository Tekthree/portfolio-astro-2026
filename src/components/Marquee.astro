---
const images = [
  { src: '/assets/images/62e5a8bf5d99644d3ee17ee8_the-breakfast-club_flyer_mockup.avif', alt: 'The Breakfast Club' },
  { src: '/assets/images/62e5a7d32fdfe161c16a7bb2_sorted_7_poster.avif', alt: 'Sorted 7' },
  { src: '/assets/images/62e5a08fdd3aac6e54184ba5_siriusmockup.avif', alt: 'Sirius' },
  { src: '/assets/images/62e5a05a9afb7e144c871ffa_crystal_method_poster_webonly.avif', alt: 'Crystal Method' },
  { src: '/assets/images/61d38d6eaedc7a746c70281a_The_breakfast_club_poster_mockup_11x17_15ONE.avif', alt: 'TBC Poster' },
  { src: '/assets/images/62e5a078f5e1735608d6196e_poster-design-minimal-copy.avif', alt: 'Minimal Poster' },
  { src: '/assets/images/61d38d80e8e6e23546bf9b51_tremulant_nikki_poster_mockup.avif', alt: 'Tremulant' },
];
---

<div class="marquee-section">
  <!-- Happy Clients badge overlaps hero above -->
  <img
    src="/assets/images/6587b2a1d6c777d8c225b483_happy_clients_three.svg"
    alt="Happy Clients"
    class="marquee-badge"
  />

  <div class="marquee-overflow">
    <div class="marquee-track">
      {[...images, ...images].map(img => (
        <div class="marquee-item">
          <img src={img.src} alt={img.alt} class="marquee-img" loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</div>

<style>
.marquee-section {
  position: relative;
  background: var(--swatch--dark-900);
  padding-top: var(--_spacing---space--7);
  padding-bottom: var(--_spacing---space--7);
  z-index: 200;
}

.marquee-badge {
  position: absolute;
  z-index: 50;
  /* fluid clamp, min 8.1rem @ 414px viewport → max 13.5rem @ 1896px viewport —
     measured directly against the original Webflow file's two reference sizes */
  width: clamp(8.1rem, 6.59rem + 5.83vw, 13.5rem);
  left: 12%;
  top: -6%;
  pointer-events: none;
}

.marquee-overflow { overflow: clip; }

.marquee-track {
  display: flex;
  width: max-content;
  /* Movement now comes entirely from the scroll-linked GSAP tween below (xPercent on
     this element) — no CSS autoplay animation. */
  will-change: transform;
}

.marquee-item {
  flex: none;
  /* fluid clamp, min 11.4rem @ 414px viewport → max 26rem @ 1896px viewport —
     measured against the original Webflow file's two reference sizes */
  width: clamp(11.4rem, 7.32rem + 15.76vw, 26rem);
  /* fluid clamp, min 11.9rem @ 414px viewport → max 21.3rem @ 1896px viewport */
  height: clamp(11.9rem, 9.27rem + 10.15vw, 21.3rem);
  overflow: clip;
}

.marquee-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: var(--radius--main);
  padding: var(--_spacing---space--1);
}

/* Mobile — badge/item repositioning only; sizes now fluid */
@media screen and (max-width: 767px) {
  .marquee-badge { left: 7%; top: -5%; }
}

@media screen and (max-width: 479px) {
  .marquee-badge { left: 5%; top: -20%; }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
    gsap.registerPlugin(ScrollTrigger);

    // Track and badge share one scrubbed timeline so they're driven by the exact same
    // scroll position — track slides left, badge turns left, scrolling down; both
    // reverse automatically (slide right / turn right) scrolling back up, since scrub
    // ties directly to scroll position rather than playing on a timer.
    gsap.timeline({
      scrollTrigger: {
        trigger: '.marquee-section',
        scrub: 0.8,
      },
    })
      .to('.marquee-badge', { y: -24, rotation: -20, ease: 'none' }, 0)
      .to('.marquee-track', { xPercent: -50, ease: 'none' }, 0);
  });
</script>
