---
const images = [
  { src: '/assets/images/62e5a8bf5d99644d3ee17ee8_the-breakfast-club_flyer_mockup.avif', alt: 'The Breakfast Club' },
  { src: '/assets/images/62e5a7d32fdfe161c16a7bb2_sorted_7_poster.avif', alt: 'Sorted 7' },
  { src: '/assets/images/62e5a08fdd3aac6e54184ba5_siriusmockup.avif', alt: 'Sirius' },
  { src: '/assets/images/62e5a05a9afb7e144c871ffa_crystal_method_poster_webonly.avif', alt: 'Crystal Method' },
  { src: '/assets/images/61d38d6eaedc7a746c70281a_The_breakfast_club_poster_mockup_11x17_15ONE.avif', alt: 'TBC Poster' },
  { src: '/assets/images/62e5a078f5e1735608d6196e_poster-design-minimal-copy.avif', alt: 'Minimal Poster' },
  { src: '/assets/images/61d38d80e8e6e23546bf9b51_tremulant_nikki_poster_mockup.avif', alt: 'Tremulant' },
];
---

<div class="marquee-section">
  <!-- Happy Clients badge overlaps hero above -->
  <img
    src="/assets/images/6587b2a1d6c777d8c225b483_happy_clients_three.svg"
    alt="Happy Clients"
    class="marquee-badge"
  />

  <div class="marquee-overflow">
    <div class="marquee-track">
      {[...images, ...images].map(img => (
        <div class="marquee-item">
          <img src={img.src} alt={img.alt} class="marquee-img" loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</div>

<style>
.marquee-section {
  position: relative;
  background: var(--swatch--dark-900);
  padding-top: var(--_spacing---space--7);
  padding-bottom: var(--_spacing---space--7);
  z-index: 200;
}

.marquee-badge {
  position: absolute;
  z-index: 50;
  width: 13.7em;
  left: 12%;
  top: -6%;
  pointer-events: none;
}

.marquee-overflow { overflow: clip; }

.marquee-track {
  display: flex;
  width: max-content;
  animation: marquee 30s linear infinite;
}

.marquee-track:hover {
  animation-play-state: paused;
}

.marquee-item {
  flex: none;
  width: 29.7em;
  height: 22.1em;
  overflow: clip;
}

.marquee-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: var(--radius--main);
  padding: var(--_spacing---space--1);
}

@keyframes marquee {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* Mobile: smaller badge, smaller items */
@media screen and (max-width: 767px) {
  .marquee-badge { width: 11em; left: 7%; top: -5%; }
  .marquee-item  { width: 18em; height: 13em; }
}

@media screen and (max-width: 479px) {
  .marquee-section { padding-top: 0.29em; padding-bottom: 0.29em; }
  .marquee-badge { width: 8.8em; left: 5%; top: -20%; }
  .marquee-item  { width: 13.7em; height: 13.4em; }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
    gsap.registerPlugin(ScrollTrigger);
    gsap.to('.marquee-badge', {
      y: -24,
      ease: 'none',
      scrollTrigger: {
        trigger: '.marquee-section',
        scrub: 0.8,
      },
    });
  });
</script>
