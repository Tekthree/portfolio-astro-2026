---
---
<section class="hero-sec">
  <!-- background gradient blobs -->
  <img src="/assets/images/61ce81425d1eb23ec48640e7_Layer_1.avif" alt="" class="bg-gradient bg-gradient--left" aria-hidden="true" />
  <img src="/assets/images/61ce81425d1eb23ec48640e7_Layer_1.avif" alt="" class="bg-gradient bg-gradient--right" aria-hidden="true" />
  <!-- right-art goes on LEFT, left-art goes on RIGHT (matches Webflow class names) -->
  <img src="/assets/images/62f6c3cffd7b99342f2f8896_right-art.avif" alt="" class="hero-side-img side-left" />
  <img src="/assets/images/62f6c3e27640277a801c55cc_left-art.avif" alt="" class="hero-side-img side-right" />

  <div class="hero-container">
    <h1 class="hero-headline u-text-style-h1">
      <span class="hero-line">a creative</span>
      <span class="hero-line">developer <span class="hero-amp">&amp;</span></span>
      <span class="hero-line">designer+</span>
    </h1>

    <p class="hero-sub u-text-style-large">Seasoned creator of innovative digital experiences</p>

    <div class="hero-cta-wrap u-button-wrapper">
      <a href="#contact" class="hero-cta" data-trigger="hover focus">let's chat🤙🏾</a>
      <div class="hero-cta-shadow"></div>
    </div>
  </div>
</section>

<style>
.hero-sec {
  background-image: url('/assets/images/61ccdb0d6c8c4a063f67c23b_hero-background-pattern.avif');
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  position: relative;
  display: block;
  overflow: clip;
}

.hero-container {
  max-width: var(--max-width--main);
  margin: 0 auto;
  /* bigger than the page-top/large tokens — this is the top-of-page hero, it should
     have the most breathing room on the page, more than a token tuned for a generic
     first section. fluid clamp, min 12rem @ 20rem viewport → max 18rem @ 90rem viewport */
  padding-top: clamp(12rem, 10.29rem + 8.57vw, 18rem);
  padding-left: var(--site--margin);
  padding-right: var(--site--margin);
  /* fluid clamp, min 10rem @ 20rem viewport → max 16rem @ 90rem viewport */
  padding-bottom: clamp(10rem, 8.29rem + 8.57vw, 16rem);
  text-align: center;
  position: relative;
  z-index: 10;
}

.hero-headline {
  font-family: var(--_typography---font--heading-family);
  font-weight: 800; /* Mortend only ships 400/800 — the token's generic bold (700) would mismatch the asset */
  /* Custom clamp instead of the h1 token's font-size: this headline is hard-wrapped into
     3 fixed phrases (not natural reflow), so the longest line ("DEVELOPER &") needs more
     side margin at mid-narrow widths than the general-purpose h1 scale gives it — the h1
     token's own min (3rem) left almost no breathing room around 600px viewport width. */
  font-size: clamp(2.25rem, 1.46rem + 3.93vw, 5rem);
  overflow-wrap: break-word;
  text-align: center;
  color: var(--swatch--light-100);
  /* tighter than the h1 token's own margin-bottom (space-7) — this hero's headline/
     sub/button block reads as one tight group, not three loosely spaced elements */
  margin-bottom: var(--_spacing---space--3);
  text-transform: uppercase;
}

.hero-line {
  display: block;
}

.hero-amp {
  color: var(--swatch--highlight-500);
  font-family: 'Mortend Outline', sans-serif;
}

.hero-sub {
  font-family: var(--_typography---font--primary-family);
  text-align: center;
  color: var(--swatch--light-100);
  margin-bottom: var(--_spacing---space--5);
}

.hero-cta-wrap {
  display: inline-flex;
  position: relative;
}

.hero-cta {
  display: block;
  background-color: color-mix(in hsl, var(--_theme---button-primary--background) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--background-hover) calc(100% * var(--_trigger---off)));
  color: color-mix(in hsl, var(--_theme---button-primary--text) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--text-hover) calc(100% * var(--_trigger---off)));
  font-family: var(--_typography---font--heading-family);
  font-weight: 700;
  letter-spacing: var(--_typography---letter-spacing--tight);
  /* skill section 8's canonical default button padding — was space-4/space-6, too chunky */
  padding: var(--_spacing---space--3) var(--_spacing---space--5);
  border-radius: var(--radius--small);
  transition: all 0.2s cubic-bezier(.544,.375,.25,1);
  text-decoration: none;
  position: relative;
  z-index: 4;
}

.hero-cta-shadow {
  background-color: color-mix(in srgb, var(--swatch--brand-500) 24%, transparent);
  border-radius: var(--radius--small);
  width: 100%;
  height: 100%;
  position: absolute;
  inset: 13% 0% 0% 3%;
}

/* Background gradient blobs — match Webflow .background-gradient */
.bg-gradient {
  position: absolute;
  z-index: 1;
  opacity: 0.77;
  filter: blur(20px);
  pointer-events: none;
}
.bg-gradient--left {
  width: 65%;
  inset: -9% auto auto -46%;
}
.bg-gradient--right {
  width: 70%;
  inset: 7% -49% 0% auto;
}

/* Side art images — Webflow: side-img-left inset:26% auto 0% 0%; side-img-right inset:21% -1% 0% auto */
.hero-side-img {
  position: absolute;
  z-index: 6;
  opacity: 0.65;
  pointer-events: none;
}

.side-left  {
  /* fluid clamp, min 6.8rem @ 20rem viewport → max 15.1rem @ 90rem viewport */
  width: clamp(6.8rem, 4.43rem + 11.86vw, 15.1rem);
  top: 26%;
  left: 0;
  bottom: 0;
}

.side-right {
  /* fluid clamp, min 6.9rem @ 20rem viewport → max 19.1rem @ 90rem viewport */
  width: clamp(6.9rem, 3.41rem + 17.43vw, 19.1rem);
  top: 21%;
  right: -1%;
  bottom: 0;
}

/* Mobile — decorative side-art repositioning only; size now scales via fluid clamp() above */
@media screen and (max-width: 767px) {
  .side-left  { top: 5%; bottom: auto; left: -5%; }
  .side-right { top: 64%; bottom: auto; right: -4%; }
}

/* Small mobile */
@media screen and (max-width: 479px) {
  .side-left  { left: -7%; }
  .side-right { top: 78%; right: -10%; }
}
</style>
