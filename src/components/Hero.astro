---
---
<section class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden">
  <!-- background pattern -->
  <div class="absolute inset-0 z-0">
    <img
      src="/assets/images/61ccdb0d6c8c4a063f67c23b_hero-background-pattern.avif"
      alt=""
      class="w-full h-full object-cover opacity-60"
    />
    <img
      src="/assets/images/61ccdb9520976e21b4e3b387_619165385dfed2318d6046fa_noise-transparent-intense.png"
      alt=""
      class="absolute inset-0 w-full h-full object-cover opacity-30 mix-blend-overlay"
    />
  </div>

  <!-- content -->
  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
    <h1 class="font-display font-black uppercase leading-none tracking-tighter text-brand-lavender mb-4" style="font-size: clamp(3rem, 10vw, 8rem);">
      A Creative<br />Developer <span class="text-brand-accent">&amp;</span><br />Designer+
    </h1>
    <p class="text-brand-lavender/70 text-lg mb-10">Seasoned creator of innovative digital experiences</p>
    <a
      href="#contact"
      class="inline-block bg-brand-mid hover:bg-brand-purple text-white font-display font-bold uppercase tracking-widest text-sm px-8 py-4 rounded-none transition-colors"
    >
      Let's Chat &#9889;
    </a>
  </div>
</section>
