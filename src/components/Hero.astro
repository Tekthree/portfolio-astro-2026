---
---
<section class="hero-sec">
  <!-- background gradient blobs -->
  <img src="/assets/images/61ce81425d1eb23ec48640e7_Layer_1.avif" alt="" class="bg-gradient bg-gradient--left" aria-hidden="true" />
  <img src="/assets/images/61ce81425d1eb23ec48640e7_Layer_1.avif" alt="" class="bg-gradient bg-gradient--right" aria-hidden="true" />
  <!-- right-art goes on LEFT, left-art goes on RIGHT (matches Webflow class names) -->
  <img src="/assets/images/62f6c3cffd7b99342f2f8896_right-art.avif" alt="" class="hero-side-img side-left" />
  <img src="/assets/images/62f6c3e27640277a801c55cc_left-art.avif" alt="" class="hero-side-img side-right" />

  <div class="hero-container">
    <h1 class="hero-headline">
      <span class="hero-line">a creative</span>
      <span class="hero-line">developer <span class="hero-amp">&amp;</span></span>
      <span class="hero-line">designer+</span>
    </h1>

    <p class="hero-sub">Seasoned creator of innovative digital experiences</p>

    <div class="hero-cta-wrap">
      <a href="#contact" class="hero-cta">let's chat🤙🏾</a>
      <div class="hero-cta-shadow"></div>
    </div>
  </div>
</section>

<style>
.hero-sec {
  background-image: url('/assets/images/61ccdb0d6c8c4a063f67c23b_hero-background-pattern.avif');
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  position: relative;
  display: block;
  overflow: hidden;
}

.hero-container {
  max-width: 100em;
  margin: 0 auto;
  padding: 13.6em 6em;
  text-align: center;
  position: relative;
  z-index: 10;
}

.hero-headline {
  font-family: Mortend, sans-serif;
  font-weight: 800;
  font-size: clamp(2rem, 5.3vw + 0.75rem, 5.5rem);
  line-height: 1.1;
  text-align: center;
  color: var(--font-light);
  margin: 0 0 0.4em;
  text-transform: uppercase;
}

.hero-line {
  display: block;
}

.hero-amp {
  color: var(--highlight-yellow);
  font-family: 'Mortend Outline', sans-serif;
}

.hero-sub {
  font-family: Poppins, sans-serif;
  font-size: 1.4em;
  text-align: center;
  color: var(--font-light);
  margin-bottom: 2.5em;
}

.hero-cta-wrap {
  margin-top: 2em;
  display: inline-block;
  position: relative;
}

.hero-cta {
  display: block;
  background-color: var(--slate-blue);
  color: rgba(12,4,44,0.75);
  font-family: Mortend, sans-serif;
  font-weight: 700;
  font-size: 1em;
  letter-spacing: 0.08em;
  padding: 1.15em 2.55em;
  border-radius: 0.6em;
  transition: transform 0.2s cubic-bezier(.544,.375,.25,1);
  text-decoration: none;
  position: relative;
  z-index: 4;
}

.hero-cta-shadow {
  background-color: rgba(109,98,180,0.24);
  border-radius: 0.6em;
  width: 100%;
  height: 100%;
  position: absolute;
  inset: 13% 0% 0% 3%;
}

/* Background gradient blobs — match Webflow .background-gradient */
.bg-gradient {
  position: absolute;
  z-index: 1;
  opacity: 0.77;
  filter: blur(20px);
  pointer-events: none;
}
.bg-gradient--left {
  width: 65%;
  inset: -9% auto auto -46%;
}
.bg-gradient--right {
  width: 70%;
  inset: 7% -49% 0% auto;
}

/* Side art images — Webflow: side-img-left inset:26% auto 0% 0%; side-img-right inset:21% -1% 0% auto */
.hero-side-img {
  position: absolute;
  z-index: 6;
  opacity: 0.65;
  pointer-events: none;
}

.side-left  {
  width: 15.1em;
  max-width: 18.8em;
  top: 26%;
  left: 0;
  bottom: 0;
}

.side-right {
  width: 19.1em;
  max-width: 22.2em;
  top: 21%;
  right: -1%;
  bottom: 0;
}

/* Tablet */
@media screen and (max-width: 991px) {
  .hero-container { padding: 10.4em 3vw 10.7em; }
  .side-left  { width: 9.1em; max-width: 11.9em; }
  .side-right { width: 9.9em; max-width: 10.1em; }
}

/* Mobile */
@media screen and (max-width: 767px) {
  .hero-container { padding-bottom: 2.3em; }
  .hero-headline  { line-height: 1.2; }
  .side-left  { width: 9.2em; top: 5%; bottom: auto; left: -5%; }
  .side-right { width: 8.3em; top: 64%; bottom: auto; right: -4%; }
}

/* Small mobile */
@media screen and (max-width: 479px) {
  .hero-container { padding: 8em 1.5em 1.4em; }
  .hero-headline  { line-height: 1.4; letter-spacing: 0.01em; }
  .side-left  { width: 6.8em; left: -7%; }
  .side-right { width: 6.9em; max-width: 8.2em; top: 78%; right: -10%; }
}
</style>
