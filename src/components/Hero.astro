---
<section class="hero-sec">
  <!-- background gradient blobs -->
  <img src="/assets/images/61ce81425d1eb23ec48640e7_Layer_1.avif" alt="" class="bg-gradient bg-gradient--left" aria-hidden="true" />
  <img src="/assets/images/61ce81425d1eb23ec48640e7_Layer_1.avif" alt="" class="bg-gradient bg-gradient--right" aria-hidden="true" />

  <div class="hero-container">
    <h1 class="hero-headline u-text-style-h1">
      <span class="hero-line">a creative</span>
      <span class="hero-line">developer <span class="hero-amp">&amp;</span></span>
      <span class="hero-line">designer+</span>
    </h1>

    <p class="hero-sub u-text-style-large">Seasoned creator of innovative digital experiences</p>

    <div class="hero-cta-wrap u-button-wrapper">
      <a href="#contact" class="hero-cta" data-trigger="hover focus">let's chat🤙🏾</a>
      <div class="hero-cta-shadow"></div>
    </div>
  </div>
</section>

<style>
.hero-sec {
  background-image: url('/assets/images/61ccdb0d6c8c4a063f67c23b_hero-background-pattern.avif');
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  /* nav is position:sticky, which (unlike the old fixed nav) occupies real space in
     document flow — its own height pushes this section down instead of floating over
     it. Pull the section back up by nav's actual measured height (--nav--actual-height,
     set by Navbar.astro's script — hand-computing this from fluid tokens/border-box
     padding proved error-prone) so the background still starts at the true top of the
     window, with nav rendering on top via its higher z-index. Fallback covers the
     no-JS/pre-hydration instant before the script runs. */
  margin-top: calc(-1 * var(--nav--actual-height, 6.5rem));
  position: relative;
  display: block;
  overflow: clip;
}

.hero-container {
  max-width: var(--max-width--main);
  margin: 0 auto;
  /* bigger than the page-top/large tokens — this is the top-of-page hero, it should
     have the most breathing room on the page, more than a token tuned for a generic
     first section. fluid clamp, min 12rem @ 20rem viewport → max 18rem @ 90rem viewport */
  padding-top: clamp(12rem, 10.29rem + 8.57vw, 18rem);
  padding-left: var(--site--margin);
  padding-right: var(--site--margin);
  /* Marquee (the next section) has its own padding-top, which stacks visually with
     this padding-bottom since both sections share the same dark background — sized
     down from the top value by roughly that amount so top/bottom read as equal.
     fluid clamp, min 7.75rem @ 20rem viewport → max 13rem @ 90rem viewport */
  padding-bottom: clamp(7.75rem, 6.25rem + 7.5vw, 13rem);
  text-align: center;
  position: relative;
  z-index: 10;
}

.hero-headline {
  font-family: var(--_typography---font--heading-family);
  font-weight: 800; /* Mortend only ships 400/800 — the token's generic bold (700) would mismatch the asset */
  /* Custom clamp instead of the h1 token's font-size: this headline is hard-wrapped into
     3 fixed phrases (not natural reflow), so the longest line ("DEVELOPER &") needs more
     side margin at mid-narrow widths than the general-purpose h1 scale gives it — the h1
     token's own min (3rem) left almost no breathing room around 600px viewport width.
     Floor tuned so "developer &" (the longest line) doesn't word-wrap down to 360px —
     verified empirically, that line's natural width exceeds the container's available
     width above ~2.05rem at 360px. Below 360px it wraps to 2 lines rather than shrink
     further, since going smaller there started looking disproportionate to the other
     two lines. Same 5rem ceiling at 1440px as before. */
  font-size: clamp(2rem, 1rem + 4.4444vw, 5rem);
  overflow-wrap: break-word;
  text-align: center;
  color: var(--swatch--light-100);
  /* tighter than the h1 token's own margin-bottom (space-7) — this hero's headline/
     sub/button block reads as one tight group, not three loosely spaced elements */
  margin-bottom: var(--_spacing---space--3);
  text-transform: uppercase;
}

.hero-line {
  display: block;
}

.hero-amp {
  color: var(--swatch--highlight-500);
  font-family: 'Mortend Outline', sans-serif;
}

.hero-sub {
  font-family: var(--_typography---font--primary-family);
  text-align: center;
  color: var(--swatch--light-100);
  opacity: 0.85;
  margin-bottom: var(--_spacing---space--5);
}

.hero-cta-wrap {
  display: inline-flex;
  position: relative;
}

.hero-cta {
  display: block;
  background-color: color-mix(in hsl, var(--_theme---button-primary--background) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--background-hover) calc(100% * var(--_trigger---off)));
  /* dark text on the brand-500 bg per explicit request, overriding the shared
     brand-text token (which nav/mobile-menu buttons still use) */
  color: color-mix(in hsl, var(--swatch--dark-900) calc(100% * var(--_trigger---on)), var(--_theme---button-primary--text-hover) calc(100% * var(--_trigger---off)));
  font-family: var(--_typography---font--heading-family);
  font-weight: 700;
  letter-spacing: var(--_typography---letter-spacing--tight);
  /* skill section 8's canonical default button padding — was space-4/space-6, too chunky */
  padding: var(--_spacing---space--3) var(--_spacing---space--5);
  border-radius: var(--radius--small);
  transition: all 0.2s cubic-bezier(.544,.375,.25,1);
  text-decoration: none;
  position: relative;
  z-index: 4;
}

.hero-cta-shadow {
  background-color: color-mix(in srgb, var(--swatch--brand-500) 24%, transparent);
  border-radius: var(--radius--small);
  width: 100%;
  height: 100%;
  position: absolute;
  inset: 13% 0% 0% 3%;
}

/* Background gradient blobs — match Webflow .background-gradient */
.bg-gradient {
  position: absolute;
  z-index: 1;
  opacity: 0.77;
  filter: blur(20px);
  pointer-events: none;
  /* Source image is nearly square (705x723) — at width:65-70% of a wide hero, auto
     height balloons to 800-900px. On a wide-but-short browser window that's taller
     than the visible viewport, pushing most of the blob off-screen so the corner it's
     anchored to reads as empty. Capping height independently (object-fit crops the
     soft blur imperceptibly) keeps both blobs visible near their corner regardless of
     window aspect ratio, without changing the width/position already matched to the
     original Webflow file. */
  height: auto;
  max-height: clamp(18rem, 42vh, 38rem);
  object-fit: cover;
}
/* Matches the original Webflow source's background-gradient element exactly:
   width 65%/70%, inset -9%/-46% (left) and 7%/-49% (right), relative to the
   hero container — confirmed against the live Webflow file's own inspector. */
.bg-gradient--left {
  width: 65%;
  inset: -9% auto auto -46%;
}
.bg-gradient--right {
  width: 70%;
  /* top:auto (not the original 7%) — with both top and bottom set, height stretches
     between them, which on a tall mobile hero pulled the blob's visible top edge way
     up instead of it sitting compactly at the bottom corner. Height now follows the
     image's own aspect ratio at width:70%, anchored purely by bottom+right. */
  inset: auto -49% 0% auto;
}
</style>
